{
  "server": {
    "logLevel": "info",
    "http": {
      "port": 8080,
      "bindAddress": "0.0.0.0"
    },
    "storage": {
      "artifactsDir": "/runner/artifacts"
    },
    "documentStore": {
      "connectionString": "mongodb://mongo:27017",
      "database": "confector"
    },
    "plugins": {
      "pluginsUploadDir": "",
      "bundledPluginsDir": "./plugins",
      "confectorPlugins": ""
    }
  },
  "plugins": {
    "mongo-queue": {
      "connectionString": "mongodb://mongo:27017",
      "dbName": "confector"
    },
    "local-process": {
      "runnerBinary": "/code/build/out/runner/confector-runner",
      "serverUrl": "http://development:8080",
      "workspaceDir": "/runner/workspace",
      "storageDir": "/runner/artifacts",
      "pluginsDir": "/code/build/out/runner/plugins",
      "maxConcurrency": 0,
      "supportedExecutorTypes": ["local", "local_process", ""]
    }
  }
}