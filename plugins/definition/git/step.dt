div.step-subform.step-subform-git
  div.form-group
    label Repository Input
    input.form-control.step-field-input(type="text", name="step_param_input", placeholder="Name of a repository input declared on this task, e.g. src", value=inputName)
    small.form-help-text Checks out exactly the commit the build pinned for this input.
  div.form-group
    label Target Subdirectory (Optional)
    input.form-control.step-field-target-dir(type="text", name="step_param_target_dir", placeholder="Subdirectory inside workspace (defaults to root workspace directory)", value=targetDir)
    small.form-help-text Relative subdirectory path. Leave empty to check out directly into the workspace root.
