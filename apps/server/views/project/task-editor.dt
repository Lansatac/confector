extends layout

block maincontent
  - import vibe.data.json : serializeToJson;
  - import std.array : replace;
  - struct TaskOpt { string id; string name; }
  - TaskOpt[] availableTasksList;
  - foreach(t; project.tasks) { if (t.id != task.id) availableTasksList ~= TaskOpt(t.id, t.name); }
  - string availableTasksJson = serializeToJson(availableTasksList).toString().replace("<", "\\u003c");
  - struct RepoOpt { string name; string address; }
  - RepoOpt[] availableReposList;
  - foreach(r; repositories) { availableReposList ~= RepoOpt(r.name, r.address); }
  - string availableReposJson = serializeToJson(availableReposList).toString().replace("<", "\\u003c");
  - string initialStepsJson = serializeToJson(form.stepRows).toString().replace("<", "\\u003c");
  - string stepTypesJson = serializeToJson(stepTypes).toString().replace("<", "\\u003c");
  - string initialInputsJson = serializeToJson(form.inputRows).toString().replace("<", "\\u003c");
  - string stepIssuesJson = serializeToJson(stepIssues).toString().replace("<", "\\u003c");

  div.projects-container
    div.header-section
      div(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 #{task.id.length > 0 ? "Edit Task: " ~ task.id : "Add New Task"}
          p Configure the task's named inputs, build steps, and output declarations for project #{project.name}.
        div(style="display: flex; gap: 8px;")
          - if (task.id.length > 0)
            a.btn.btn-outline(href="/tasks/details?project_id=#{project.id}&task_id=#{task.id}") Back to Task Details
          a.btn.btn-outline(href="/projects/details?id=#{project.id}") Back to Project

    - if (formError.length > 0)
      div.alert.alert-danger#task-form-error(style="margin-top: 20px; white-space: pre-line;")
        strong The task was not saved:
        div #{formError}

    form#task-form(action="/projects/tasks/save", method="POST", style="margin-top: 20px;")
      input(type="hidden", name="project_id", value="#{project.id}")

      div.tabs-nav
        button.tab-btn.active(type="button", onclick="switchTab('general', this)") General
        button.tab-btn(type="button", onclick="switchTab('inputs', this)") Inputs
        button.tab-btn(type="button", onclick="switchTab('steps', this)") Steps
        button.tab-btn(type="button", onclick="switchTab('outputs', this)") Outputs

      div.card
        div#tab-general.tab-pane.active
          h3 General Settings
          div.form-group
            label(for="task_id") Task Identifier (ID):
            input.form-control#task_id(type="text", name="task_id", value="#{task.id}", placeholder="e.g. build-release, test-unit, deploy-stage", required)

          div.form-group
            label(for="name") Display Name:
            input.form-control#name(type="text", name="name", value="#{task.name}", placeholder="e.g. Build Release Binary")

          div.form-group
            label(for="timeout_seconds") Timeout (seconds):
            input.form-control#timeout_seconds(type="number", name="timeout_seconds", min="1", step="1", value="#{form.timeoutText}", required)

          div.form-group
            label(for="environment") Environment variables for every step, one per line as KEY=VALUE:
            textarea.form-control#environment(name="environment", rows="4", placeholder="CONFIGURATION=Release", style="font-family: monospace;") #{form.environmentText}

        div#tab-inputs.tab-pane
          h3 Inputs
          p(style="color: #666; margin-bottom: 15px; font-size: 0.9em;") Name everything this task depends on. A repository input is a registered repository; the build request chooses its ref. It may narrow which refs are allowed with a branch filter (for example +:* -:experimental/*) and give a default ref spec for when the request names none (a ref such as main, or same else main). A task output input depends on an upstream task, and optionally one of its artifacts. A value input is a literal value. Checkout steps pick a repository input by name.
          div#inputs-container
          div(style="margin-top: 6px;")
            button.btn.btn-outline.btn-sm#add-input-btn(type="button", onclick="addInputRow()") + Add Input

        div#tab-steps.tab-pane
          h3 Ordered Build Steps
          p(style="color: #666; margin-bottom: 15px; font-size: 0.9em;") Build steps run sequentially in order. Each step has a type and a JSON config object; a checkout step names a repository input declared in the Inputs tab, for example {"input": "src"}.
          div#steps-container.step-list
          div(style="margin-top: 15px; display: flex; flex-wrap: wrap; gap: 8px;")
            button.btn.btn-outline.btn-sm#add-step-btn(type="button", onclick="addBuildStep()") + Add Step

        div#tab-outputs.tab-pane
          h3 Output Artifacts
          div.form-group
            label(for="output_artifacts") Produced output artifacts, one per line as id: path (both required; the path is relative to the working directory and may be a glob):
            textarea.form-control#output_artifacts(name="output_artifacts", rows="4", placeholder="binaries: bin/*\nsymbols: build/*.pdb", style="font-family: monospace;") #{form.outputsText}

        div(style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #eee; display: flex; gap: 10px;")
          button.btn.btn-primary(type="submit") Save Task
          a.btn.btn-outline(href="/projects/details?id=#{project.id}") Cancel

  script.
    var availableTasks = !{availableTasksJson};
    var availableRepos = !{availableReposJson};
    var initialSteps = !{initialStepsJson} || [];
    var stepTypes = !{stepTypesJson};
    var initialInputs = !{initialInputsJson} || [];
    var stepIssues = !{stepIssuesJson} || [];

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    // ---- Named inputs -------------------------------------------------------------------------

    var INPUT_KINDS = [
      { value: 'repository', label: 'Repository' },
      { value: 'task_output', label: 'Task output' },
      { value: 'value', label: 'Value' }
    ];

    function inputField(cls, labelText, control) {
      var wrap = document.createElement('div');
      wrap.className = 'input-field ' + cls;
      wrap.style.cssText = 'flex: 1; min-width: 160px;';
      var label = document.createElement('label');
      label.style.cssText = 'font-size: 0.85em; display: block;';
      label.textContent = labelText;
      wrap.appendChild(label);
      wrap.appendChild(control);
      return wrap;
    }

    function textControl(name, value, placeholder) {
      var el = document.createElement('input');
      el.type = 'text';
      el.name = name;
      el.className = 'form-control';
      el.placeholder = placeholder || '';
      el.value = value || '';
      return el;
    }

    // A select of `options` ({value, label}); keeps `current` selectable even when it is not
    // among the options, so a stale reference is shown (and rejected on save) rather than lost.
    function selectControl(name, options, current, placeholder) {
      var el = document.createElement('select');
      el.name = name;
      el.className = 'form-control';
      var first = document.createElement('option');
      first.value = '';
      first.textContent = placeholder;
      el.appendChild(first);
      var found = false;
      for (var i = 0; i < options.length; i++) {
        var opt = document.createElement('option');
        opt.value = options[i].value;
        opt.textContent = options[i].label;
        if (options[i].value === current) { opt.selected = true; found = true; }
        el.appendChild(opt);
      }
      if (current && !found) {
        var stale = document.createElement('option');
        stale.value = current;
        stale.textContent = current + ' (not available)';
        stale.selected = true;
        el.appendChild(stale);
      }
      return el;
    }

    function onInputKindChange(kindSelect) {
      var row = kindSelect.closest('.input-row');
      if (!row) return;
      var kind = kindSelect.value;
      var visible = { repository: ['repo', 'branches', 'default'], task_output: ['task', 'artifact'], value: ['value'] }[kind] || [];
      var all = ['repo', 'branches', 'default', 'task', 'artifact', 'value'];
      for (var i = 0; i < all.length; i++) {
        var field = row.querySelector('.input-field-' + all[i]);
        if (field) field.style.display = visible.indexOf(all[i]) !== -1 ? '' : 'none';
      }
      // Required in the browser only where the field applies; the server checks again.
      var needs = { repo: 'repository', task: 'task_output', value: 'value' };
      for (var key in needs) {
        var control = row.querySelector('.input-field-' + key + ' select, .input-field-' + key + ' input');
        if (control) control.required = (needs[key] === kind);
      }
    }

    function removeInputRow(btn) {
      var row = btn.closest('.input-row');
      if (row) {
        row.remove();
      }
    }

    function addInputRow(data) {
      var container = document.getElementById('inputs-container');
      if (!container) return;
      var d = data || {};

      var row = document.createElement('div');
      row.className = 'input-row';
      row.style.cssText = 'display: flex; flex-wrap: wrap; gap: 8px; align-items: flex-end; margin-bottom: 10px; padding: 10px; border: 1px solid #e0e0e0; border-radius: 6px; background: #fafafa;';

      var nameControl = textControl('input_name', d.name, 'e.g. src');
      nameControl.required = true;
      row.appendChild(inputField('input-field-name', 'Name', nameControl));

      var kindControl = document.createElement('select');
      kindControl.name = 'input_kind';
      kindControl.className = 'form-control';
      for (var i = 0; i < INPUT_KINDS.length; i++) {
        var opt = document.createElement('option');
        opt.value = INPUT_KINDS[i].value;
        opt.textContent = INPUT_KINDS[i].label;
        if (INPUT_KINDS[i].value === (d.kind || 'repository')) opt.selected = true;
        kindControl.appendChild(opt);
      }
      kindControl.onchange = function() { onInputKindChange(this); };
      row.appendChild(inputField('input-field-kind', 'Kind', kindControl));

      var repoOptions = (availableRepos || []).map(function(r) {
        return { value: r.name, label: r.name + (r.address ? ' (' + r.address + ')' : '') };
      });
      row.appendChild(inputField('input-field-repo', 'Repository', selectControl('input_repository', repoOptions, d.repository, '-- Select a repository --')));
      // The input does not choose the ref, the build request does: the input may narrow which
      // refs are allowed and give a default ref spec for when the request says nothing.
      row.appendChild(inputField('input-field-branches', 'Branch filter (optional)', textControl('input_branches', d.branches, 'e.g. +:* -:experimental/*')));
      row.appendChild(inputField('input-field-default', 'Default ref (optional)', textControl('input_default', d.defaultRef, 'e.g. main, same else main')));

      var taskOptions = (availableTasks || []).map(function(t) {
        return { value: t.id, label: t.id + (t.name && t.name !== t.id ? ' (' + t.name + ')' : '') };
      });
      row.appendChild(inputField('input-field-task', 'Upstream task', selectControl('input_task', taskOptions, d.task, '-- Select a task --')));
      row.appendChild(inputField('input-field-artifact', 'Artifact (optional)', textControl('input_artifact', d.artifact, 'artifact id; empty = depend on the task only')));

      row.appendChild(inputField('input-field-value', 'Value', textControl('input_value', d.value, 'literal value')));

      var removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-danger btn-sm';
      removeBtn.textContent = '✕';
      removeBtn.title = 'Remove input';
      removeBtn.onclick = function() { removeInputRow(this); };
      row.appendChild(removeBtn);

      container.appendChild(row);
      onInputKindChange(kindControl);
    }

    // ---- Build steps --------------------------------------------------------------------------
    // Each step is a name, a built-in step type and its config as a JSON object. The config is
    // validated when the task is saved; there are no per-type forms.

    function updateStepIndices() {
      var container = document.getElementById('steps-container');
      if (!container) return;
      var rows = container.querySelectorAll('.step-row');
      for (var i = 0; i < rows.length; i++) {
        var badge = rows[i].querySelector('.step-index-badge');
        if (badge) {
          badge.textContent = 'Step ' + (i + 1);
        }
      }
    }

    function removeStep(btn) {
      var row = btn.closest('.step-row');
      if (row) {
        row.remove();
        updateStepIndices();
      }
    }

    function moveStepUp(btn) {
      var row = btn.closest('.step-row');
      if (row && row.previousElementSibling) {
        row.parentNode.insertBefore(row, row.previousElementSibling);
        updateStepIndices();
      }
    }

    function moveStepDown(btn) {
      var row = btn.closest('.step-row');
      if (row && row.nextElementSibling) {
        row.parentNode.insertBefore(row.nextElementSibling, row);
        updateStepIndices();
      }
    }

    function controlButton(text, title, cls, onclick) {
      var btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-sm ' + cls;
      btn.textContent = text;
      btn.title = title;
      btn.onclick = function() { onclick(this); };
      return btn;
    }

    // Adds a step row for `data` ({name, type, config}, config as JSON text), with the problems
    // the server found in it, if any.
    function addBuildStep(data, issues) {
      var container = document.getElementById('steps-container');
      if (!container) return;
      var d = data || {};

      var row = document.createElement('div');
      row.className = 'step-row';

      var header = document.createElement('div');
      header.className = 'step-header';

      var leftControls = document.createElement('div');
      leftControls.style.cssText = 'display: flex; align-items: center; gap: 10px; flex: 1; margin-right: 15px;';

      var badge = document.createElement('span');
      badge.className = 'step-index-badge';
      badge.textContent = 'Step';
      leftControls.appendChild(badge);

      var typeOptions = stepTypes.map(function(t) { return { value: t, label: t }; });
      // A new step starts as the first type; a submitted step keeps its type, even an empty one,
      // so the problem stays visible
      var typeSelect = selectControl('step_type', typeOptions, data ? d.type : stepTypes[0], '-- Select a step type --');
      typeSelect.required = true;
      typeSelect.style.cssText = 'width: 180px; font-weight: bold;';
      leftControls.appendChild(typeSelect);

      var nameInput = textControl('step_name', d.name, 'Step name (e.g. Fetch source, Build binary)');
      leftControls.appendChild(nameInput);

      header.appendChild(leftControls);

      var rightControls = document.createElement('div');
      rightControls.className = 'step-controls';
      rightControls.appendChild(controlButton('↑', 'Move step up', 'btn-outline', moveStepUp));
      rightControls.appendChild(controlButton('↓', 'Move step down', 'btn-outline', moveStepDown));
      rightControls.appendChild(controlButton('✕', 'Remove step', 'btn-danger', removeStep));
      header.appendChild(rightControls);
      row.appendChild(header);

      var body = document.createElement('div');
      body.className = 'step-body';

      if (issues && issues.length > 0) {
        var box = document.createElement('div');
        box.className = 'alert alert-danger step-issues';
        var title = document.createElement('strong');
        title.textContent = 'This step needs attention:';
        box.appendChild(title);
        var list = document.createElement('ul');
        list.style.cssText = 'margin: 6px 0 0 18px;';
        for (var n = 0; n < issues.length; n++) {
          var li = document.createElement('li');
          li.textContent = issues[n];
          list.appendChild(li);
        }
        box.appendChild(list);
        body.appendChild(box);
      }

      var configLabel = document.createElement('label');
      configLabel.style.cssText = 'font-size: 0.9em; display: block;';
      configLabel.textContent = 'Config (a JSON object; for checkout: input, target_dir, depth, submodules):';
      body.appendChild(configLabel);
      var config = document.createElement('textarea');
      config.name = 'step_config';
      config.className = 'form-control code-font';
      config.rows = 4;
      config.placeholder = '{}';
      config.value = d.config !== undefined ? d.config : '{}';
      body.appendChild(config);

      row.appendChild(body);
      container.appendChild(row);
      updateStepIndices();
    }

    function switchTab(tabName, btn) {
      var panes = document.querySelectorAll('.tab-pane');
      for (var i = 0; i < panes.length; i++) {
        panes[i].classList.remove('active');
      }
      var buttons = document.querySelectorAll('.tab-btn');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove('active');
      }
      var target = document.getElementById('tab-' + tabName);
      if (target) {
        target.classList.add('active');
      }
      if (btn) {
        btn.classList.add('active');
      }
    }

    document.addEventListener("DOMContentLoaded", function() {
      for (var n = 0; n < initialInputs.length; n++) {
        addInputRow(initialInputs[n]);
      }
      for (var i = 0; i < initialSteps.length; i++) {
        addBuildStep(initialSteps[i], stepIssues[i]);
      }
    });
