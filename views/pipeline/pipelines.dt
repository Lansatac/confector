extends layout

block maincontent
  div.pipeline-container
    div.header-section
      div(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 DAG Pipelines
          p Directed Acyclic Graph execution with content-addressed caching, node triggers, and memoization.
        div
          a.btn.btn-primary(href="/pipelines/edit") + Author Pipeline

    div.section-title-bar(style="margin-top: 20px;")
      h2 Author & Execute Pipelines

    - if (pipelines.length == 0)
      div.empty-state
        p No pipelines configured yet.
        a.btn.btn-primary(href="/pipelines/edit") Author Your First Pipeline
    - else
      table.data-table
        thead
          tr
            th Pipeline ID
            th Project ID
            th Name
            th Tasks
            th Description
            th Actions
        tbody
          - foreach(pipe; pipelines)
            tr
              td
                code #{pipe.id}
              td
                a(href="/projects/details?id=#{pipe.projectId}") #{pipe.projectId}
              td
                strong #{pipe.name}
              td
                span.badge.badge-info #{pipe.definition.tasks.length} node(s)
              td #{pipe.description}
              td
                a.btn.btn-sm.btn-outline(href="/pipelines/edit?id=#{pipe.id}", style="margin-right: 5px;") Edit DAG
                form(action="/pipelines/run", method="POST", style="display:inline; margin-right: 5px;")
                  input(type="hidden", name="id", value="#{pipe.id}")
                  button.btn.btn-sm.btn-primary(type="submit") Execute
                form(action="/pipelines/delete", method="POST", style="display:inline;")
                  input(type="hidden", name="id", value="#{pipe.id}")
                  button.btn.btn-sm.btn-danger(type="submit", onclick="return confirm('Delete pipeline?');") Delete

    div.section-title-bar(style="margin-top: 30px;")
      h2 Pipeline DAG Visualizer
      div.graph-legend
        span.legend-item
          span.dot.dot-primary
          span Ready Node
        span.legend-item
          span.dot.dot-cached
          span Content Cached

    div#pipeline-canvas-container.dag-visualizer
      canvas#pipeline-canvas(width="800", height="240")

    div.grid-2col(style="margin-top: 30px;")
      div.card
        h3 Ad-Hoc Pipeline Execution
        p Dispatch execution for custom inline task graph.
        
        form#pipeline-run-form(action="/api/v1/pipeline/execute", method="POST")
          div.form-group
            label(for="target_node") Target Node (Blank for full graph):
            input.form-control#target_node(type="text", name="target_node", placeholder="e.g. compile-release")
          
          div.form-group
            label(for="workspace_dir") Workspace Directory:
            input.form-control#workspace_dir(type="text", name="workspace_dir", value=".", placeholder="Local directory path")

          div.form-group.checkbox-group
            input#force_execution(type="checkbox", name="force", value="true")
            label(for="force_execution") Force Execution (Bypass Content-Addressed Cache)

          button.btn.btn-primary#btn-dispatch-pipeline(type="button") Dispatch Execution

      div.card
        h3 Configured Pipeline Triggers
        - if (triggers.length == 0)
          div.empty-state
            p No triggers configured for this pipeline.
            a.btn.btn-sm.btn-outline(href="/triggers/") Setup Triggers
        - else
          table.data-table
            thead
              tr
                th Trigger Name
                th Target Node
                th Event Type
                th Criteria
            tbody
              - foreach(t; triggers)
                tr
                  td #{t.name}
                  td #{t.targetTaskId}
                  td
                    span.badge.badge-info #{t.triggerType}
                  td #{t.criteria}

  script(src="/static/scripts/dag_visualizer.js")
  script.
    document.addEventListener("DOMContentLoaded", function() {
      if (window.renderSamplePipeline) {
        window.renderSamplePipeline("pipeline-canvas");
      }

      var dispatchBtn = document.getElementById("btn-dispatch-pipeline");
      if (dispatchBtn) {
        dispatchBtn.addEventListener("click", function() {
          var targetNode = document.getElementById("target_node").value;
          var workspace = document.getElementById("workspace_dir").value || ".";
          var force = document.getElementById("force_execution").checked;

          var sampleTasks = [
            { id: "unit-tests", name: "Unit Tests", depends_on: [], script: "dub test", inputs: { files: ["source/**/*.d"] } },
            { id: "compile-release", name: "Compile Binary", depends_on: ["unit-tests"], script: "dub build --build=release", inputs: { files: ["source/**/*.d", "dub.json"] }, outputs: { artifacts: [{ path: "confector.exe", type: "file" }] } },
            { id: "verify-artifact", name: "Verify Artifact", depends_on: ["compile-release"], script: "confector.exe --version || echo Binary verified", inputs: { upstream_artifacts: [{ task_id: "compile-release", name: "confector.exe" }] } }
          ];

          var buildId = "build_" + Date.now();
          var payload = {
            build_id: buildId,
            workspace_dir: workspace,
            pipeline: { version: "1.0", tasks: sampleTasks },
            event: {
              type: "manual",
              target_task_id: targetNode,
              force: force,
              parameters: {}
            }
          };

          dispatchBtn.disabled = true;
          dispatchBtn.innerText = "Executing...";

          fetch("/api/v1/pipeline/execute", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            window.location.href = "/builds/details?id=" + buildId;
          })
          .catch(function(err) {
            alert("Execution error: " + err);
            dispatchBtn.disabled = false;
            dispatchBtn.innerText = "Dispatch Execution";
          });
        });
      }
    });
