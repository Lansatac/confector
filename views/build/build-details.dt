extends layout

block maincontent
  div.build-details-container
    div.header-section
      div.title-row
        h1 Build Details: #{build.buildId}
        div.status-container
          - if (build.status == "succeeded")
            span.badge.badge-lg.badge-success SUCCESS
          - else if (build.status == "cached")
            span.badge.badge-lg.badge-cached CACHED
          - else if (build.status == "failed")
            span.badge.badge-lg.badge-danger FAILED
          - else if (build.status == "running")
            span.badge.badge-lg.badge-warning RUNNING
          - else
            span.badge.badge-lg.badge-secondary #{build.status}

    div.details-grid
      div.detail-item
        strong Project:
        span  #{build.projectName}
      div.detail-item
        strong Trigger Source:
        span  #{build.triggerSource}
      div.detail-item
        strong Target Task:
        span  #{build.targetTaskId.length > 0 ? build.targetTaskId : "Full Graph"}
      div.detail-item
        strong Started:
        span  #{build.startedAt}
      div.detail-item
        strong Finished:
        span  #{build.finishedAt}
      div.detail-item
        strong Total Duration:
        span  #{build.durationMs} ms

    - if (build.errorMessage.length > 0)
      div.alert.alert-danger
        strong Error: 
        span #{build.errorMessage}

    div.section-title-bar(style="margin-top: 30px;")
      h2 Task Execution Graph
      div.graph-legend
        span.legend-item
          span.dot.dot-success
          span Succeeded
        span.legend-item
          span.dot.dot-cached
          span Cached
        span.legend-item
          span.dot.dot-running
          span Running
        span.legend-item
          span.dot.dot-failed
          span Failed
        span.legend-item
          span.dot.dot-repo
          span Repository

    div#dag-container.dag-visualizer
      canvas#dag-canvas(width="800", height="240")
      div.dag-node-list
        - foreach(taskId; build.executedTasks)
          a.dag-node-card(href="/tasks/execution?build_id=#{build.buildId}&task_id=#{taskId}", data-task="#{taskId}", style="text-decoration: none; color: inherit; display: block;")
            div.node-header
              span.node-id #{taskId}
              - auto pStatus = taskId in taskStatuses;
              - auto statusStr = pStatus !is null ? *pStatus : (build.status == "cached" ? "cached" : (build.status == "failed" ? "failed" : "succeeded"));
              - if (statusStr == "succeeded" || statusStr == "success")
                span.badge.badge-sm.badge-success OK
              - else if (statusStr == "cached")
                span.badge.badge-sm.badge-cached CACHED
              - else if (statusStr == "failed")
                span.badge.badge-sm.badge-danger FAILED
              - else if (statusStr == "running")
                span.badge.badge-sm.badge-warning RUNNING
              - else
                span.badge.badge-sm.badge-secondary #{statusStr}
            div.node-meta
              - if (statusStr == "cached")
                span Cached (0 ms)
              - else if (statusStr == "failed")
                span Failed
              - else
                span Executed
              span(style="margin-left: 8px; color: var(--primary-color, #3b82f6);") View Details &rarr;

    div.section-title-bar(style="margin-top: 30px;")
      h2 Live Execution Logs
      div.log-controls
        button.btn.btn-sm.btn-outline#btn-autoscroll Auto-scroll: ON
        button.btn.btn-sm.btn-primary#btn-refresh-logs Refresh Logs

    div.terminal-box#live-terminal(data-build-id="#{build.buildId}")
      - if (logs.length == 0)
        div.log-empty No log output recorded for this build.
      - else
        - foreach(line; logs)
          div.log-line #{line}

  script(src="/static/scripts/dag_visualizer.js")
  script.
    document.addEventListener("DOMContentLoaded", function() {
      var tasksData = !{tasksJson};
      var taskStatusesData = !{taskStatusesJson};
      if (tasksData && tasksData.length && window.renderTaskGraph) {
        window.renderTaskGraph("dag-canvas", tasksData, taskStatusesData);
      }
    });
  script(src="/static/scripts/live_logs.js")
