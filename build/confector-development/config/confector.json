{
  "server": {
    "logLevel": "info",
    "http": {
      "port": 8080,
      "bindAddress": "0.0.0.0"
    },
    "storage": {
      "mongoHost": "mongo:27017/confector",
      "secretPath": "/run/secrets/mongo-readwrite-password",
      "artifactsDir": ".confector/artifacts"
    },
    "plugins": {
      "pluginsUploadDir": "",
      "bundledPluginsDir": "/code/bin/plugins",
      "confectorPlugins": ""
    }
  },
  "plugins": {
    "local-process": {
      "runnerBinary": "/code/bin/runner/confector-runner",
      "serverUrl": "http://localhost:8080",
      "workspaceDir": "/runner/workspace",
      "storageDir": "/runner/artifacts",
      "pluginsDir": "plugins",
      "maxConcurrency": 0,
      "supportedExecutorTypes": ["local", "local_process", ""]
    }
  }
}