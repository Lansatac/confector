extends layout

block maincontent
  div.tasks-container
    div.header-section
      h1 Task Queue & Execution Stream
      p Real-time inspection of distributed DAG task execution units, cache status, and worker dispatch.

    div.section-title-bar(style="margin-top: 10px; margin-bottom: 15px;")
      h2 Active Work Queue
      div
        span.badge.badge-primary #{queuedTasks.length} queued

    - if (queuedTasks.length == 0)
      div.empty-state(style="margin-bottom: 30px; padding: 20px;")
        p Task queue is empty. No tasks currently awaiting worker dispatch.
    - else
      table.data-table(style="margin-bottom: 30px;")
        thead
          tr
            th Message ID
            th Task ID
            th Parent Build
            th Enqueued At
            th Attempt
            th Visibility Timeout
        tbody
          - foreach(msg; queuedTasks)
            tr
              td #{msg.messageId}
              td
                strong #{msg.taskId}
              td
                a.build-link(href="/builds/details?id=#{msg.buildId}") #{msg.buildId}
              td #{msg.createdAt}
              td #{msg.attempt} / #{msg.maxAttempts}
              td #{msg.timeoutSeconds}s

    div.section-title-bar(style="margin-top: 20px; margin-bottom: 15px;")
      h2 Task Execution Stream
      div.filter-bar
        - if (statusFilter.length > 0 || projectFilter.length > 0)
          a.btn.btn-sm.btn-outline(href="/tasks/") Clear Filters

    - if (recentTasks.length == 0)
      div.empty-state
        p No task executions recorded.
        a.btn.btn-primary(href="/projects/") Run Project Tasks
    - else
      table.data-table
        thead
          tr
            th Task ID
            th Parent Build
            th Project
            th Status
            th Fingerprint
            th Duration
            th Started
            th Actions
        tbody
          - foreach(t; recentTasks)
            tr
              td
                a.task-link(href="/tasks/execution?build_id=#{t.buildId}&task_id=#{t.taskId}", style="font-weight: 600;") #{t.taskId}
              td
                a.build-link(href="/builds/details?id=#{t.buildId}") #{t.buildId}
              td #{t.projectName.length > 0 ? t.projectName : (t.projectId.length > 0 ? t.projectId : "default")}
              td
                - if (t.status == "succeeded")
                  span.badge.badge-success SUCCESS
                - else if (t.status == "cached")
                  span.badge.badge-cached CACHED
                - else if (t.status == "failed")
                  span.badge.badge-danger FAILED
                - else if (t.status == "running")
                  span.badge.badge-warning RUNNING
                - else
                  span.badge.badge-secondary #{t.status}
              td
                - if (t.fingerprint.length >= 8)
                  code #{t.fingerprint[0 .. 8]}...
                - else if (t.fingerprint.length > 0)
                  code #{t.fingerprint}
                - else
                  span.text-muted -
              td #{t.durationMs} ms
              td #{t.startedAt}
              td
                a.btn.btn-sm(href="/tasks/execution?build_id=#{t.buildId}&task_id=#{t.taskId}") Steps & Logs
