extends layout

block maincontent
  div.admin-container
    div.header-section
      div(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 Plugin Administration
          p Manage dynamic runtime plugins, view active system capabilities, and configure modular execution extensions.
        div

    - if (errorMessage.length > 0)
      div.alert.alert-danger(style="margin-top: 15px; padding: 12px; background-color: #fee2e2; border: 1px solid #ef4444; color: #b91c1c; border-radius: 6px;")
        strong Error: 
        span #{errorMessage}

    - if (successMessage.length > 0)
      div.alert.alert-success(style="margin-top: 15px; padding: 12px; background-color: #dcfce7; border: 1px solid #22c55e; color: #15803d; border-radius: 6px;")
        strong Success: 
        span #{successMessage}

    div.stats-grid(style="margin-top: 20px;")
      div.stat-card
        div.stat-value #{plugins.length}
        div.stat-label Total Active Plugins
      div.stat-card
        div.stat-value #{dynamicCount}
        div.stat-label Dynamically Loaded Libraries
      div.stat-card
        div.stat-value #{stepSystemsCount}
        div.stat-label Registered Step Systems
      div.stat-card
        div.stat-value #{executorProvidersCount}
        div.stat-label Executor Providers

    div.card(style="margin-top: 25px; padding: 20px; background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px;")
      h3(style="margin-top: 0; margin-bottom: 8px;") Load Dynamic Plugin Library
      p(style="color: #64748b; font-size: 0.9em; margin-bottom: 16px;") Specify the path to a compiled plugin dynamic library (.dll on Windows, .so on Linux, .dylib on macOS).
      form(action="/admin/plugins/load", method="POST", style="display: flex; gap: 10px; align-items: center;")
        input.form-control(type="text", name="libraryPath", placeholder="e.g. plugins/git/confector_git.dll or /opt/confector/plugins/libcustom.so", style="flex: 1; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px;", required)
        button.btn.btn-primary(type="submit", style="padding: 8px 16px;") Load Plugin

    div.section-title-bar(style="margin-top: 35px;")
      h2 Active Plugins & Capabilities

    - if (plugins.length == 0)
      div.empty-state
        p No plugins are currently loaded in the registry.
    - else
      table.data-table(style="margin-top: 15px; width: 100%; border-collapse: collapse;")
        thead
          tr(style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0; text-align: left;")
            th(style="padding: 10px 12px;") Plugin Name
            th(style="padding: 10px 12px;") Version
            th(style="padding: 10px 12px;") Type & Source
            th(style="padding: 10px 12px;") Description
            th(style="padding: 10px 12px;") Actions
        tbody
          - foreach(p; plugins)
            tr(style="border-bottom: 1px solid #e2e8f0;")
              td(style="padding: 10px 12px; font-weight: bold;")
                div #{p.name}
              td(style="padding: 10px 12px;")
                span.badge.badge-secondary #{p.versionString}
              td(style="padding: 10px 12px;")
                - if (p.isBundled)
                  span.badge.badge-primary(style="background-color: #dbeafe; color: #1e40af; padding: 3px 8px; border-radius: 4px; font-size: 0.8em;") Bundled Plugin
                  div(style="font-size: 0.8em; color: #64748b; margin-top: 4px; font-family: monospace;") #{p.path}
                - else if (p.isDynamic)
                  span.badge.badge-success(style="background-color: #dcfce7; color: #166534; padding: 3px 8px; border-radius: 4px; font-size: 0.8em;") Dynamic Library
                  div(style="font-size: 0.8em; color: #64748b; margin-top: 4px; font-family: monospace;") #{p.path}
                - else
                  span.badge.badge-secondary(style="background-color: #f1f5f9; color: #475569; padding: 3px 8px; border-radius: 4px; font-size: 0.8em;") Static / Core
              td(style="padding: 10px 12px; color: #334155; font-size: 0.9em;")
                div #{p.description}
              td(style="padding: 10px 12px;")
                - if (p.isDynamic)
                  form(action="/admin/plugins/unload", method="POST", style="margin: 0; display: inline;")
                    input(type="hidden", name="pluginName", value="#{p.name}")
                    button.btn.btn-sm.btn-danger(type="submit", onclick="return confirm('Unload plugin #{p.name}?');", style="padding: 4px 8px; font-size: 0.85em; background: #ef4444; color: white; border: none; border-radius: 4px; cursor: pointer;") Unload
                - else
                  span(style="color: #94a3b8; font-size: 0.85em;") Core Protected
