{
  "authors": [
    "Jason Yegge"
  ],
  "copyright": "Copyright © 2023, Jason Yegge",
  "description": "A build system.",
  "license": "The Unlicense",
  "name": "confector",
  "targetType": "none",
  "importPaths": ["source", "plugins"],
  "dependencies": {
    "confector-server": { "path": "source/confector/server" },
    "confector-runner": { "path": "source/confector/runner" },
    "confector:plugins": "*"
  },
  "subPackages": [
    "source/confector/config",
    "source/confector/server",
    "source/confector/plugin_api",
    "source/confector/mongo_helpers",
    "source/confector/core",
    "source/confector/runner_core",
    "source/confector/runner",
    "./plugins/definition/bash",
    "./plugins/definition/git",
    "./plugins/definition/powershell",
    "./plugins/step_executor/bash",
    "./plugins/step_executor/git",
    "./plugins/step_executor/powershell",
    "./plugins/worker/local_process",
    "./plugins/artifact/local",
    "./plugins/storage/mongo",
    "./plugins/queue/mongo",
    "./plugins/scheduler/local",
    {
      "name": "plugins",
      "targetType": "none",
      "dependencies": {
        "bash_def": { "path": "plugins/definition/bash" },
        "bash_runner": { "path": "plugins/step_executor/bash" },
        "git_def": { "path": "plugins/definition/git" },
        "git_runner": { "path": "plugins/step_executor/git" },
        "powershell_def": { "path": "plugins/definition/powershell" },
        "powershell_runner": { "path": "plugins/step_executor/powershell" },
        "local_process": { "path": "plugins/worker/local_process" },
        "local_artifact": { "path": "plugins/artifact/local" },
        "mongo_storage": { "path": "plugins/storage/mongo" },
        "mongo_queue": { "path": "plugins/queue/mongo" },
        "local_scheduler": { "path": "plugins/scheduler/local" }
      }
    }
  ]
}