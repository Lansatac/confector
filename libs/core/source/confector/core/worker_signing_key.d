module confector.core.worker_signing_key;

/**
 * The worker token signing key of an installation. Unless a key is configured, the server uses one
 * random key per installation, kept in a singleton document of the state store. The key is created
 * by compare-and-set (put-if-absent), so instances that start at once agree on it, and a restarted
 * server, or another instance, reads the same key and keeps accepting the tokens already issued.
 */

import confector.core.document_collection;
import confector.core.worker_token : requireSigningKey;
import confector.api.document_store;

import std.digest : LetterCase, toHexString;
import std.format : format;
import vibe.crypto.cryptorand : secureRNG;

/// Signing keys, by installation key id. One document per installation; read only by id.
enum CollectionSpec workerSigningKeysCollection = CollectionSpec("worker_signing_keys", null);

/// The id of the installation's key document.
enum string installationKeyId = "installation";

/// The random bytes a generated key is made from; the key is their hex text, 64 characters.
enum size_t generatedKeyBytes = 32;

/// Where the key the server signs with came from.
enum SigningKeySource
{
    /// Set in configuration: an override of the stored key, which is then left alone.
    configured,
    /// Read from the document store, where an earlier start put it.
    stored,
    /// Generated by this start and stored, because none existed.
    generated,
}

/// The key a server signs worker tokens with, and where it came from.
struct ResolvedSigningKey
{
    string key;
    SigningKeySource source;
}

/// Makes a candidate key. Called only when no key is stored yet.
alias SigningKeyGenerator = string delegate();

/**
 * Returns `generatedKeyBytes` cryptographically secure random bytes as lowercase hex text.
 *
 * Throws: CryptoException (vibe.crypto) if the random source fails.
 */
string generateWorkerSigningKey()
{
    ubyte[generatedKeyBytes] bytes;
    secureRNG().read(bytes[]);
    return toHexString!(LetterCase.lower)(bytes[]).idup;
}

/**
 * The installation's signing key, kept in the document store.
 */
final class WorkerSigningKeyStore
{
    private DocumentCollection!StoredSigningKey m_keys;

    /// Declares `workerSigningKeysCollection` on `store`.
    this(DocumentStore store)
    {
        m_keys = new DocumentCollection!StoredSigningKey(store, workerSigningKeysCollection);
    }

    /**
     * The key to sign worker tokens with. A `configured` key (non-empty) wins and is neither
     * stored nor compared with the stored one. Otherwise the stored key is read; if there is none,
     * `generate` makes one and it is created in the store, or, if another start created one first,
     * the winner's key is read and used.
     *
     * Throws: Exception if the configured, generated or stored key is shorter than
     * minimumSigningKeyLength bytes, or if the source of the random bytes fails;
     * MalformedDocumentException if the stored document cannot be read as a key.
     */
    ResolvedSigningKey resolve(string configured, SigningKeyGenerator generate)
    {
        if (configured.length > 0)
        {
            requireSigningKey(configured);
            return ResolvedSigningKey(configured, SigningKeySource.configured);
        }

        auto stored = m_keys.get(installationKeyId);
        if (!stored.isNull)
            return ResolvedSigningKey(checkedStoredKey(stored.get.value.key), SigningKeySource.stored);

        const generated = generate();
        requireSigningKey(generated);
        try
        {
            m_keys.create(installationKeyId, StoredSigningKey(generated));
            return ResolvedSigningKey(generated, SigningKeySource.generated);
        }
        catch (DocumentConflictException)
        {
            // Another start stored its key first: use that one, so every instance agrees.
        }

        auto winner = m_keys.get(installationKeyId);
        if (winner.isNull)
            throw new Exception(format("Worker signing key '%s' in collection '%s' is missing after a concurrent create lost to it",
                installationKeyId, workerSigningKeysCollection.name));
        return ResolvedSigningKey(checkedStoredKey(winner.get.value.key), SigningKeySource.stored);
    }

    private static string checkedStoredKey(string key)
    {
        try
            requireSigningKey(key);
        catch (Exception e)
            throw new MalformedDocumentException(format("Worker signing key '%s' in collection '%s' is unusable: %s",
                installationKeyId, workerSigningKeysCollection.name, e.msg), workerSigningKeysCollection.name, installationKeyId);
        return key;
    }
}

/// The stored content of the installation's key document.
private struct StoredSigningKey
{
    string key;
}

unittest
{
    // Random keys are 64 lowercase hex characters, and differ
    const first = generateWorkerSigningKey();
    const second = generateWorkerSigningKey();
    assert(first.length == 2 * generatedKeyBytes);
    foreach (c; first) assert((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'));
    assert(first != second);
}

version (unittest)
{
    import confector.testing.memory_document_store : InMemoryDocumentStore, InterleavingDocumentStore;
    import std.exception : assertThrown;

    private enum firstKey = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    private enum secondKey = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    private enum configuredKey = "0123456789abcdef0123456789abcdef";
}

unittest
{
    import confector.core.worker_token : WorkerTokenClaims, mintWorkerToken, verifyWorkerToken;

    // With no key configured, the first start generates and stores one
    auto documents = new InMemoryDocumentStore();
    auto keys = new WorkerSigningKeyStore(documents);
    auto first = keys.resolve("", () => firstKey);
    assert(first.key == firstKey && first.source == SigningKeySource.generated);
    assert(documents.get(workerSigningKeysCollection.name, installationKeyId).get.version_ == 1);

    // A later start, or a restarted server, reads the same key and does not generate another
    auto restarted = new WorkerSigningKeyStore(documents.restart());
    auto again = restarted.resolve("", () => secondKey);
    assert(again.key == firstKey && again.source == SigningKeySource.stored);

    // A token minted before the restart is accepted after it
    WorkerTokenClaims claims;
    claims.executionId = "exe_1";
    claims.fingerprint = "fp_1";
    claims.receipt = "receipt_1";
    claims.attempt = 1;
    claims.expiresAt = 2_000_000;
    const token = mintWorkerToken(first.key, claims);
    assert(verifyWorkerToken(again.key, token, 1_000_000) == claims);
}

unittest
{
    // Two starts that both find no key: the second creates it first, so the first loses the
    // create and uses the winner's key, and the document is written once
    auto documents = new InMemoryDocumentStore();
    auto interleaving = new InterleavingDocumentStore(documents);
    auto racing = new WorkerSigningKeyStore(interleaving);
    auto other = new WorkerSigningKeyStore(documents);

    ResolvedSigningKey winner;
    interleaving.beforeNextWrite = () { winner = other.resolve("", () => secondKey); };
    auto loser = racing.resolve("", () => firstKey);
    assert(winner.source == SigningKeySource.generated && winner.key == secondKey);
    assert(loser.key == secondKey && loser.source == SigningKeySource.stored);
    assert(documents.get(workerSigningKeysCollection.name, installationKeyId).get.version_ == 1);
}

unittest
{
    import std.algorithm.searching : canFind;
    import std.exception : collectException;

    auto documents = new InMemoryDocumentStore();
    auto keys = new WorkerSigningKeyStore(documents);
    keys.resolve("", () => firstKey);

    // A configured key overrides the stored one, and the stored one is left as it was
    auto overridden = keys.resolve(configuredKey, () => secondKey);
    assert(overridden.key == configuredKey && overridden.source == SigningKeySource.configured);
    assert(keys.resolve("", () => secondKey).key == firstKey);

    // A configured key that is too short is refused, even when a key is stored
    auto tooShort = collectException(keys.resolve("short", () => secondKey));
    assert(tooShort !is null && tooShort.msg.canFind("at least 32"), tooShort.msg);

    // A generated key that is too short is refused, and nothing is stored
    auto empty = new WorkerSigningKeyStore(new InMemoryDocumentStore());
    assertThrown!Exception(empty.resolve("", () => "short"));
    assert(empty.resolve("", () => firstKey).source == SigningKeySource.generated);
}

unittest
{
    import confector.core.document_collection : MalformedDocumentException;
    import std.algorithm.searching : canFind;
    import std.exception : collectException;
    import vibe.data.json : serializeToJson;

    // A stored key too short to sign with is reported, not used
    auto documents = new InMemoryDocumentStore();
    auto keys = new WorkerSigningKeyStore(documents);
    documents.create(workerSigningKeysCollection.name, installationKeyId, serializeToJson(StoredSigningKey("short")));
    auto failure = cast(MalformedDocumentException) collectException(keys.resolve("", () => firstKey));
    assert(failure !is null && failure.id == installationKeyId && failure.msg.canFind("at least 32"), failure.msg);
}
