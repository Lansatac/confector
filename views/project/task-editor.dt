extends layout

block maincontent
  - import vibe.data.json : serializeToJson;
  - import confector.core.model : TriggerType, BuildStep;
  - struct TaskOpt { string id; string name; }
  - TaskOpt[] availableTasksList;
  - foreach(t; project.tasks) { if (t.id != task.id) availableTasksList ~= TaskOpt(t.id, t.name); }
  - string availableTasksJson = serializeToJson(availableTasksList).toString();
  - struct RepoOpt { string name; string address; }
  - RepoOpt[] availableReposList;
  - foreach(r; repositories) { availableReposList ~= RepoOpt(r.name, r.address); }
  - string availableReposJson = serializeToJson(availableReposList).toString();
  - string initialStepsJson = serializeToJson(task.steps).toString();

  div.projects-container
    div.header-section
      div(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 #{task.id.length > 0 ? "Edit Task: " ~ task.id : "Add New Task"}
          p Configure discrete DAG node inputs, dependencies, plugin build steps, and output declarations for project #{project.name}.
        div
          a.btn.btn-outline(href="/projects/details?id=#{project.id}") Back to Project

    form#task-form(action="/projects/tasks/save", method="POST", onsubmit="prepareTaskForm()", style="margin-top: 20px;")
      input(type="hidden", name="project_id", value="#{project.id}")
      input(type="hidden", name="steps_json", id="steps_json", value="")

      div.tabs-nav
        button.tab-btn.active(type="button", onclick="switchTab('general', this)") General
        button.tab-btn(type="button", onclick="switchTab('inputs', this)") Inputs
        button.tab-btn(type="button", onclick="switchTab('steps', this)") Steps
        button.tab-btn(type="button", onclick="switchTab('outputs', this)") Outputs
        button.tab-btn(type="button", onclick="switchTab('triggers', this)") Triggers

      div.card
        div#tab-general.tab-pane.active
          h3 General Settings
          div.form-group
            label(for="task_id") Task Identifier (ID):
            input.form-control#task_id(type="text", name="task_id", value="#{task.id}", placeholder="e.g. build-release, test-unit, deploy-stage", required)

          div.form-group
            label(for="name") Display Name:
            input.form-control#name(type="text", name="name", value="#{task.name}", placeholder="e.g. Build Release Binary")

        div#tab-inputs.tab-pane
          h3 Inputs & Upstream Dependencies
          div.form-group
            label Task Dependencies (Other tasks in this project):
            div#dependencies-container.dependency-list
              - foreach(dep; task.dependsOn)
                div.dependency-row(style="display: flex; gap: 8px; margin-bottom: 8px; align-items: center;")
                  select.form-control(name="depends_on", style="flex: 1;")
                    option(value="", disabled) -- Select a task --
                    - bool foundDep = false;
                    - foreach(t; project.tasks)
                      - if (t.id != task.id)
                        - if (t.id == dep)
                          - foundDep = true;
                          option(value="#{t.id}", selected) #{t.id}#{t.name.length > 0 ? " (" ~ t.name ~ ")" : ""}
                        - else
                          option(value="#{t.id}") #{t.id}#{t.name.length > 0 ? " (" ~ t.name ~ ")" : ""}
                    - if (!foundDep && dep.length > 0)
                      option(value="#{dep}", selected) #{dep}
                  button.btn.btn-danger.btn-sm.btn-remove-dep(type="button", onclick="removeDependency(this)", title="Remove dependency") ✕
            div(style="margin-top: 6px;")
              button.btn.btn-outline.btn-sm#add-dep-btn(type="button", onclick="addDependency()") + Add Dependency

          div.form-group
            label Repository Dependencies:
            div#repo-dependencies-container.dependency-list
              - foreach(repoDep; task.inputs.repositories)
                div.dependency-row(style="display: flex; gap: 8px; margin-bottom: 8px; align-items: center;")
                  select.form-control(name="repositories", style="flex: 1;")
                    option(value="", disabled) -- Select a repository --
                    - bool foundRepo = false;
                    - foreach(r; repositories)
                      - if (r.name == repoDep || r.address == repoDep)
                        - foundRepo = true;
                        option(value="#{r.name}", selected) #{r.name}#{r.address.length > 0 ? " (" ~ r.address ~ ")" : ""}
                      - else
                        option(value="#{r.name}") #{r.name}#{r.address.length > 0 ? " (" ~ r.address ~ ")" : ""}
                    - if (!foundRepo && repoDep.length > 0)
                      option(value="#{repoDep}", selected) #{repoDep}
                  button.btn.btn-danger.btn-sm.btn-remove-repo(type="button", onclick="removeRepoDependency(this)", title="Remove repository") ✕
            div(style="margin-top: 6px;")
              button.btn.btn-outline.btn-sm#add-repo-btn(type="button", onclick="addRepoDependency()") + Add Repository

          div.form-group
            label(for="upstream_artifacts") Required Upstream Artifacts (Format: taskId:artifactPath per line):
            - string upVal = "";
            - foreach(i, up; task.inputs.upstreamArtifacts) { if (i > 0) upVal ~= "\n"; upVal ~= up.taskId ~ ":" ~ up.name; }
            textarea.form-control#upstream_artifacts(name="upstream_artifacts", rows="3", placeholder="build-release:confector.exe\ncompile:build/game.zip", style="font-family: monospace;") #{upVal}

        div#tab-steps.tab-pane
          h3 Ordered Build Steps
          p(style="color: #666; margin-bottom: 15px; font-size: 0.9em;") Configure plugin-defined build steps (Git repository cloning, process script/commands, or custom plugin steps) executed sequentially in order.
          div#steps-container.step-list
          div(style="margin-top: 15px; display: flex; flex-wrap: wrap; gap: 8px;")
            button.btn.btn-outline.btn-sm#add-process-step-btn(type="button", onclick="addBuildStep('process')") + Add Process / Script Step
            button.btn.btn-outline.btn-sm#add-clone-step-btn(type="button", onclick="addBuildStep('clone_repository')") + Add Clone Repository Step
            button.btn.btn-outline.btn-sm#add-custom-step-btn(type="button", onclick="addBuildStep('custom')") + Add Custom Step

          div.form-group(style="margin-top: 20px; padding-top: 15px; border-top: 1px dashed #ddd;")
            label(for="working_directory") Default Task Working Directory Override (Optional):
            input.form-control#working_directory(type="text", name="working_directory", value="#{task.workingDirectory}", placeholder="Leave blank to use project workspace")

        div#tab-outputs.tab-pane
          h3 Output Artifacts
          div.form-group
            label(for="output_artifacts") Produced Output Artifacts (Format: filePath:type or filePath per line):
            - string outVal = "";
            - foreach(i, outArt; task.outputs.artifacts) { if (i > 0) outVal ~= "\n"; outVal ~= outArt.path ~ (outArt.type.length > 0 ? ":" ~ outArt.type : ""); }
            textarea.form-control#output_artifacts(name="output_artifacts", rows="4", placeholder="bin/confector.exe:binary\nbuild/output.tar.gz:archive", style="font-family: monospace;") #{outVal}

        div#tab-triggers.tab-pane
          h3 Triggers & Event Dispatches
          p(style="color: #666; margin-bottom: 15px; font-size: 0.9em;") Configure node-level triggers (Git Push, Git Tag, Webhook, Cron, Manual) that automatically dispatch this task and its downstream graph slice.
          div#triggers-container.trigger-list
            - foreach(trig; task.triggers)
              div.trigger-row(style="border: 1px solid #e0e0e0; background: #fafafa; border-radius: 6px; padding: 15px; margin-bottom: 12px; position: relative;")
                div(style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;")
                  div(style="display: flex; align-items: center; gap: 10px;")
                    label(style="font-weight: bold; margin: 0;") Trigger Type:
                    select.form-control(name="trigger_type", style="width: auto;", onchange="onTriggerTypeChange(this)")
                      option(value="git_push", selected=(trig.type == TriggerType.gitPush)) Git Push (Commit/Branch)
                      option(value="git_tag", selected=(trig.type == TriggerType.gitTag)) Git Tag (Release)
                      option(value="webhook", selected=(trig.type == TriggerType.webhook)) Webhook (HTTP Endpoint)
                      option(value="cron", selected=(trig.type == TriggerType.cron)) Cron Schedule
                      option(value="manual", selected=(trig.type == TriggerType.manual)) Manual Dispatch
                  button.btn.btn-danger.btn-sm.btn-remove-trig(type="button", onclick="removeTriggerRule(this)", title="Remove trigger") ✕

                - string branchStr = "";
                - foreach(i, b; trig.branches) { if (i > 0) branchStr ~= ", "; branchStr ~= b; }
                - string tagStr = "";
                - foreach(i, tg; trig.tags) { if (i > 0) tagStr ~= ", "; tagStr ~= tg; }

                div.trigger-fields
                  div.form-group.field-branches(style=(trig.type == TriggerType.gitPush ? "margin-bottom: 8px;" : "display: none; margin-bottom: 8px;"))
                    label Branch Patterns (Comma-separated globs, e.g. main, feature/*):
                    input.form-control(type="text", name="trigger_branches", value="#{branchStr}", placeholder="e.g. main, feature/*, release/*")
                  div.form-group.field-tags(style=(trig.type == TriggerType.gitTag ? "margin-bottom: 8px;" : "display: none; margin-bottom: 8px;"))
                    label Tag Patterns (Comma-separated globs, e.g. v*.*.*, release-*):
                    input.form-control(type="text", name="trigger_tags", value="#{tagStr}", placeholder="e.g. v*.*.*, release-*")
                  div.form-group.field-endpoint(style=(trig.type == TriggerType.webhook ? "margin-bottom: 8px;" : "display: none; margin-bottom: 8px;"))
                    label Webhook Endpoint Path:
                    input.form-control(type="text", name="trigger_endpoint", value="#{trig.endpoint}", placeholder="e.g. /api/v1/triggers/deploy")
                  div.form-group.field-cron(style=(trig.type == TriggerType.cron ? "margin-bottom: 8px;" : "display: none; margin-bottom: 8px;"))
                    label Cron Schedule Expression:
                    input.form-control(type="text", name="trigger_cron", value="#{trig.cronSchedule}", placeholder="e.g. 0 0 * * 0")
          div(style="margin-top: 10px;")
            button.btn.btn-outline.btn-sm#add-trig-btn(type="button", onclick="addTriggerRule()") + Add Trigger Rule

        div(style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #eee; display: flex; gap: 10px;")
          button.btn.btn-primary(type="submit") Save Task
          a.btn.btn-outline(href="/projects/details?id=#{project.id}") Cancel

  script.
    var availableTasks = !{availableTasksJson};
    var availableRepos = !{availableReposJson};
    var initialSteps = !{initialStepsJson} || [];
    var initialScript = !{serializeToJson(task.script).toString()};
    var initialTaskWorkDir = !{serializeToJson(task.workingDirectory).toString()};

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function updateStepIndices() {
      var container = document.getElementById('steps-container');
      if (!container) return;
      var rows = container.querySelectorAll('.step-row');
      for (var i = 0; i < rows.length; i++) {
        var badge = rows[i].querySelector('.step-index-badge');
        if (badge) {
          badge.textContent = 'Step ' + (i + 1);
        }
      }
    }

    function removeStep(btn) {
      var row = btn.closest('.step-row');
      if (row) {
        row.remove();
        updateStepIndices();
      }
    }

    function moveStepUp(btn) {
      var row = btn.closest('.step-row');
      if (row && row.previousElementSibling) {
        row.parentNode.insertBefore(row, row.previousElementSibling);
        updateStepIndices();
      }
    }

    function moveStepDown(btn) {
      var row = btn.closest('.step-row');
      if (row && row.nextElementSibling) {
        row.parentNode.insertBefore(row.nextElementSibling, row);
        updateStepIndices();
      }
    }

    function onStepTypeChange(selectElem) {
      var row = selectElem.closest('.step-row');
      if (!row) return;
      var val = selectElem.value;
      var processFields = row.querySelector('.step-fields-process');
      var cloneFields = row.querySelector('.step-fields-clone');
      var customFields = row.querySelector('.step-fields-custom');

      if (processFields) processFields.style.display = (val === 'process' || val === 'script' || val === 'command') ? 'block' : 'none';
      if (cloneFields) cloneFields.style.display = (val === 'clone_repository' || val === 'git_clone' || val === 'checkout_repository') ? 'block' : 'none';
      if (customFields) customFields.style.display = (val === 'custom') ? 'block' : 'none';
    }

    function onStepRepoSelect(selectElem) {
      var row = selectElem.closest('.step-row');
      if (!row) return;
      var input = row.querySelector('.step-repo-url-input');
      if (input && selectElem.value.length > 0) {
        input.value = selectElem.value;
      }
    }

    function addBuildStep(defaultType, stepData) {
      var container = document.getElementById('steps-container');
      if (!container) return;

      var data = stepData || {};
      var type = data.type || defaultType || 'process';
      var normalizedType = type;
      if (type === 'clone_repository' || type === 'git_clone' || type === 'checkout_repository' || type === 'git') {
        normalizedType = 'clone_repository';
      } else if (type === 'process' || type === 'script' || type === 'command' || type === 'shell') {
        normalizedType = 'process';
      } else if (type !== 'custom') {
        normalizedType = 'custom';
      }

      var name = data.name || (normalizedType === 'clone_repository' ? 'Clone Repository' : (normalizedType === 'process' ? 'Execute Script' : 'Custom Step'));
      var script = data.script || data.command || '';
      var workDir = data.working_directory || data.workingDirectory || '';
      var params = data.parameters || {};
      var repoUrl = params.repository || params.url || params.address || '';
      var branch = params.branch || '';
      var targetDir = params.target_dir || params.targetDirectory || params.target || '';
      var propsStr = data.properties ? JSON.stringify(data.properties, null, 2) : '';

      var row = document.createElement('div');
      row.className = 'step-row';

      var header = document.createElement('div');
      header.className = 'step-header';

      var leftControls = document.createElement('div');
      leftControls.style.cssText = 'display: flex; align-items: center; gap: 10px; flex: 1; margin-right: 15px;';

      var badge = document.createElement('span');
      badge.className = 'step-index-badge';
      badge.textContent = 'Step';
      leftControls.appendChild(badge);

      var typeSelect = document.createElement('select');
      typeSelect.name = 'step_type';
      typeSelect.className = 'form-control';
      typeSelect.style.cssText = 'width: 220px; font-weight: bold;';
      typeSelect.onchange = function() { onStepTypeChange(this); };

      var optProcess = document.createElement('option');
      optProcess.value = 'process';
      optProcess.textContent = 'Process / Script Runner';
      if (normalizedType === 'process') optProcess.selected = true;
      typeSelect.appendChild(optProcess);

      var optClone = document.createElement('option');
      optClone.value = 'clone_repository';
      optClone.textContent = 'Clone Repository (Git)';
      if (normalizedType === 'clone_repository') optClone.selected = true;
      typeSelect.appendChild(optClone);

      var optCustom = document.createElement('option');
      optCustom.value = 'custom';
      optCustom.textContent = 'Custom Plugin Step';
      if (normalizedType === 'custom') optCustom.selected = true;
      typeSelect.appendChild(optCustom);

      leftControls.appendChild(typeSelect);

      var nameInput = document.createElement('input');
      nameInput.type = 'text';
      nameInput.name = 'step_name';
      nameInput.className = 'form-control';
      nameInput.placeholder = 'Step Name / Label (e.g. Build Binary, Fetch Source)';
      nameInput.value = name;
      leftControls.appendChild(nameInput);

      header.appendChild(leftControls);

      var rightControls = document.createElement('div');
      rightControls.className = 'step-controls';

      var upBtn = document.createElement('button');
      upBtn.type = 'button';
      upBtn.className = 'btn btn-outline btn-sm';
      upBtn.textContent = '↑';
      upBtn.title = 'Move step up';
      upBtn.onclick = function() { moveStepUp(this); };
      rightControls.appendChild(upBtn);

      var downBtn = document.createElement('button');
      downBtn.type = 'button';
      downBtn.className = 'btn btn-outline btn-sm';
      downBtn.textContent = '↓';
      downBtn.title = 'Move step down';
      downBtn.onclick = function() { moveStepDown(this); };
      rightControls.appendChild(downBtn);

      var removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-danger btn-sm';
      removeBtn.textContent = '✕';
      removeBtn.title = 'Remove step';
      removeBtn.onclick = function() { removeStep(this); };
      rightControls.appendChild(removeBtn);

      header.appendChild(rightControls);
      row.appendChild(header);

      var body = document.createElement('div');
      body.className = 'step-body';

      // Process fields
      var processDiv = document.createElement('div');
      processDiv.className = 'step-fields-process';
      processDiv.style.display = (normalizedType === 'process') ? 'block' : 'none';

      var procScriptGroup = document.createElement('div');
      procScriptGroup.className = 'form-group';
      procScriptGroup.style.marginBottom = '8px';
      procScriptGroup.innerHTML = '<label style="font-size: 0.9em; font-weight: bold;">Script / Shell Command:</label>' +
        '<textarea class="form-control" name="step_script" rows="4" style="font-family: monospace;" placeholder="e.g. dub build --build=release">' + (normalizedType === 'process' ? escapeHtml(script) : '') + '</textarea>';
      processDiv.appendChild(procScriptGroup);

      var procDirGroup = document.createElement('div');
      procDirGroup.className = 'form-group';
      procDirGroup.style.marginBottom = '0';
      procDirGroup.innerHTML = '<label style="font-size: 0.9em;">Step Working Directory (Optional):</label>' +
        '<input class="form-control" type="text" name="step_working_dir" value="' + escapeHtml(workDir) + '" placeholder="Leave blank to use task workspace directory">';
      processDiv.appendChild(procDirGroup);
      body.appendChild(processDiv);

      // Clone fields
      var cloneDiv = document.createElement('div');
      cloneDiv.className = 'step-fields-clone';
      cloneDiv.style.display = (normalizedType === 'clone_repository') ? 'block' : 'none';

      var cloneRepoGroup = document.createElement('div');
      cloneRepoGroup.className = 'form-group';
      cloneRepoGroup.style.marginBottom = '8px';

      var repoSelectHtml = '<option value="">-- Choose registered repository or enter URL below --</option>';
      var repos = availableRepos || [];
      for (var r = 0; r < repos.length; r++) {
        var rAddr = repos[r].address || repos[r].name;
        var selected = (repoUrl === rAddr || repoUrl === repos[r].name) ? ' selected' : '';
        repoSelectHtml += '<option value="' + escapeHtml(rAddr) + '"' + selected + '>' + escapeHtml(repos[r].name + (repos[r].address ? ' (' + repos[r].address + ')' : '')) + '</option>';
      }

      cloneRepoGroup.innerHTML = '<label style="font-size: 0.9em; font-weight: bold;">Repository URL / Address:</label>' +
        '<div style="display: flex; gap: 8px; margin-bottom: 6px;">' +
          '<select class="form-control" style="flex: 1;" onchange="onStepRepoSelect(this)">' + repoSelectHtml + '</select>' +
        '</div>' +
        '<input class="form-control step-repo-url-input" type="text" name="step_repo_url" value="' + escapeHtml(repoUrl) + '" placeholder="https://github.com/org/repo.git">';
      cloneDiv.appendChild(cloneRepoGroup);

      var cloneGrid = document.createElement('div');
      cloneGrid.style.cssText = 'display: grid; grid-template-columns: 1fr 1fr; gap: 10px;';
      cloneGrid.innerHTML = '<div class="form-group" style="margin-bottom: 0;">' +
          '<label style="font-size: 0.9em;">Branch / Tag / Ref (Optional):</label>' +
          '<input class="form-control" type="text" name="step_repo_branch" value="' + escapeHtml(branch) + '" placeholder="e.g. main, v1.0.0">' +
        '</div>' +
        '<div class="form-group" style="margin-bottom: 0;">' +
          '<label style="font-size: 0.9em;">Target Directory (Optional):</label>' +
          '<input class="form-control" type="text" name="step_repo_target" value="' + escapeHtml(targetDir) + '" placeholder="Leave blank for repo name">' +
        '</div>';
      cloneDiv.appendChild(cloneGrid);
      body.appendChild(cloneDiv);

      // Custom fields
      var customDiv = document.createElement('div');
      customDiv.className = 'step-fields-custom';
      customDiv.style.display = (normalizedType === 'custom') ? 'block' : 'none';

      customDiv.innerHTML = '<div class="form-group" style="margin-bottom: 8px;">' +
          '<label style="font-size: 0.9em; font-weight: bold;">Custom Step Type Identifier:</label>' +
          '<input class="form-control" type="text" name="step_custom_type" value="' + escapeHtml(type !== 'process' && type !== 'clone_repository' ? type : '') + '" placeholder="e.g. docker:build, s3:sync, artifact:publish">' +
        '</div>' +
        '<div class="form-group" style="margin-bottom: 8px;">' +
          '<label style="font-size: 0.9em;">Step Command / Script / Payload:</label>' +
          '<textarea class="form-control" name="step_custom_script" rows="3" style="font-family: monospace;" placeholder="Command or payload string">' + (normalizedType === 'custom' ? escapeHtml(script) : '') + '</textarea>' +
        '</div>' +
        '<div class="form-group" style="margin-bottom: 0;">' +
          '<label style="font-size: 0.9em;">Custom JSON Properties (Optional):</label>' +
          '<textarea class="form-control" name="step_props" rows="2" style="font-family: monospace;" placeholder="{}">' + escapeHtml(propsStr) + '</textarea>' +
        '</div>';
      body.appendChild(customDiv);

      row.appendChild(body);
      container.appendChild(row);
      updateStepIndices();
    }

    function prepareTaskForm() {
      var container = document.getElementById('steps-container');
      if (!container) return;
      var rows = container.querySelectorAll('.step-row');
      var steps = [];
      for (var i = 0; i < rows.length; i++) {
        var row = rows[i];
        var typeSelect = row.querySelector('[name="step_type"]');
        var type = typeSelect ? typeSelect.value : 'process';
        var nameInput = row.querySelector('[name="step_name"]');
        var name = nameInput ? nameInput.value.trim() : '';

        var stepObj = {
          name: name
        };

        if (type === 'process') {
          stepObj.type = 'process';
          var sElem = row.querySelector('.step-fields-process [name="step_script"]');
          if (sElem && sElem.value.length > 0) stepObj.script = sElem.value;
          var wElem = row.querySelector('.step-fields-process [name="step_working_dir"]');
          if (wElem && wElem.value.trim().length > 0) stepObj.working_directory = wElem.value.trim();
        } else if (type === 'clone_repository') {
          stepObj.type = 'clone_repository';
          var rUrlElem = row.querySelector('[name="step_repo_url"]');
          var bElem = row.querySelector('[name="step_repo_branch"]');
          var tElem = row.querySelector('[name="step_repo_target"]');
          var params = {};
          if (rUrlElem && rUrlElem.value.trim().length > 0) params.repository = rUrlElem.value.trim();
          if (bElem && bElem.value.trim().length > 0) params.branch = bElem.value.trim();
          if (tElem && tElem.value.trim().length > 0) params.target_dir = tElem.value.trim();
          if (Object.keys(params).length > 0) stepObj.parameters = params;
        } else {
          var cTypeElem = row.querySelector('[name="step_custom_type"]');
          stepObj.type = (cTypeElem && cTypeElem.value.trim().length > 0) ? cTypeElem.value.trim() : 'custom';
          var cScriptElem = row.querySelector('[name="step_custom_script"]');
          if (cScriptElem && cScriptElem.value.length > 0) stepObj.script = cScriptElem.value;
          var cPropsElem = row.querySelector('[name="step_props"]');
          if (cPropsElem && cPropsElem.value.trim().length > 0) {
            try {
              stepObj.properties = JSON.parse(cPropsElem.value.trim());
            } catch (e) {}
          }
        }

        steps.push(stepObj);
      }

      var hiddenJson = document.getElementById('steps_json');
      if (hiddenJson) {
        hiddenJson.value = JSON.stringify(steps);
      }
    }

    function removeDependency(btn) {
      var row = btn.closest('.dependency-row');
      if (row) {
        row.remove();
      }
    }

    function addDependency(selectedId) {
      var container = document.getElementById('dependencies-container');
      if (!container) return;

      var row = document.createElement('div');
      row.className = 'dependency-row';
      row.style.cssText = 'display: flex; gap: 8px; margin-bottom: 8px; align-items: center;';

      var select = document.createElement('select');
      select.name = 'depends_on';
      select.className = 'form-control';
      select.style.flex = '1';

      var defaultOpt = document.createElement('option');
      defaultOpt.value = '';
      defaultOpt.disabled = true;
      if (!selectedId) defaultOpt.selected = true;
      defaultOpt.textContent = '-- Select a task --';
      select.appendChild(defaultOpt);

      var tasks = availableTasks || [];
      if (tasks.length === 0) {
        var noneOpt = document.createElement('option');
        noneOpt.value = '';
        noneOpt.disabled = true;
        noneOpt.textContent = 'No other tasks in this project';
        select.appendChild(noneOpt);
      } else {
        for (var i = 0; i < tasks.length; i++) {
          var opt = document.createElement('option');
          opt.value = tasks[i].id;
          opt.textContent = tasks[i].id + (tasks[i].name && tasks[i].name.length > 0 && tasks[i].name !== tasks[i].id ? ' (' + tasks[i].name + ')' : '');
          if (selectedId && tasks[i].id === selectedId) {
            opt.selected = true;
          }
          select.appendChild(opt);
        }
      }

      var removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-danger btn-sm btn-remove-dep';
      removeBtn.textContent = '✕';
      removeBtn.title = 'Remove dependency';
      removeBtn.onclick = function() { removeDependency(this); };

      row.appendChild(select);
      row.appendChild(removeBtn);
      container.appendChild(row);
    }

    function removeRepoDependency(btn) {
      var row = btn.closest('.dependency-row');
      if (row) {
        row.remove();
      }
    }

    function addRepoDependency(selectedName) {
      var container = document.getElementById('repo-dependencies-container');
      if (!container) return;

      var row = document.createElement('div');
      row.className = 'dependency-row';
      row.style.cssText = 'display: flex; gap: 8px; margin-bottom: 8px; align-items: center;';

      var select = document.createElement('select');
      select.name = 'repositories';
      select.className = 'form-control';
      select.style.flex = '1';

      var defaultOpt = document.createElement('option');
      defaultOpt.value = '';
      defaultOpt.disabled = true;
      if (!selectedName) defaultOpt.selected = true;
      defaultOpt.textContent = '-- Select a repository --';
      select.appendChild(defaultOpt);

      var repos = availableRepos || [];
      if (repos.length === 0) {
        var noneOpt = document.createElement('option');
        noneOpt.value = '';
        noneOpt.disabled = true;
        noneOpt.textContent = 'No repositories configured';
        select.appendChild(noneOpt);
      } else {
        for (var i = 0; i < repos.length; i++) {
          var opt = document.createElement('option');
          opt.value = repos[i].name;
          opt.textContent = repos[i].name + (repos[i].address && repos[i].address.length > 0 ? ' (' + repos[i].address + ')' : '');
          if (selectedName && repos[i].name === selectedName) {
            opt.selected = true;
          }
          select.appendChild(opt);
        }
      }

      var removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-danger btn-sm btn-remove-repo';
      removeBtn.textContent = '✕';
      removeBtn.title = 'Remove repository';
      removeBtn.onclick = function() { removeRepoDependency(this); };

      row.appendChild(select);
      row.appendChild(removeBtn);
      container.appendChild(row);
    }

    function switchTab(tabName, btn) {
      var panes = document.querySelectorAll('.tab-pane');
      for (var i = 0; i < panes.length; i++) {
        panes[i].classList.remove('active');
      }
      var buttons = document.querySelectorAll('.tab-btn');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove('active');
      }
      var target = document.getElementById('tab-' + tabName);
      if (target) {
        target.classList.add('active');
      }
      if (btn) {
        btn.classList.add('active');
      }
    }

    function onTriggerTypeChange(selectElem) {
      var row = selectElem.closest('.trigger-row');
      if (!row) return;
      var val = selectElem.value;
      var fieldBranches = row.querySelector('.field-branches');
      var fieldTags = row.querySelector('.field-tags');
      var fieldEndpoint = row.querySelector('.field-endpoint');
      var fieldCron = row.querySelector('.field-cron');

      if (fieldBranches) fieldBranches.style.display = (val === 'git_push') ? 'block' : 'none';
      if (fieldTags) fieldTags.style.display = (val === 'git_tag') ? 'block' : 'none';
      if (fieldEndpoint) fieldEndpoint.style.display = (val === 'webhook') ? 'block' : 'none';
      if (fieldCron) fieldCron.style.display = (val === 'cron') ? 'block' : 'none';
    }

    function removeTriggerRule(btn) {
      var row = btn.closest('.trigger-row');
      if (row) {
        row.remove();
      }
    }

    function addTriggerRule(defaultType) {
      var container = document.getElementById('triggers-container');
      if (!container) return;

      var type = defaultType || 'git_push';
      var row = document.createElement('div');
      row.className = 'trigger-row';
      row.style.cssText = 'border: 1px solid #e0e0e0; background: #fafafa; border-radius: 6px; padding: 15px; margin-bottom: 12px; position: relative;';

      var header = document.createElement('div');
      header.style.cssText = 'display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;';

      var typeWrapper = document.createElement('div');
      typeWrapper.style.cssText = 'display: flex; align-items: center; gap: 10px;';

      var label = document.createElement('label');
      label.style.cssText = 'font-weight: bold; margin: 0;';
      label.textContent = 'Trigger Type:';
      typeWrapper.appendChild(label);

      var select = document.createElement('select');
      select.name = 'trigger_type';
      select.className = 'form-control';
      select.style.width = 'auto';
      select.onchange = function() { onTriggerTypeChange(this); };

      var options = [
        { value: 'git_push', label: 'Git Push (Commit/Branch)' },
        { value: 'git_tag', label: 'Git Tag (Release)' },
        { value: 'webhook', label: 'Webhook (HTTP Endpoint)' },
        { value: 'cron', label: 'Cron Schedule' },
        { value: 'manual', label: 'Manual Dispatch' }
      ];

      for (var i = 0; i < options.length; i++) {
        var opt = document.createElement('option');
        opt.value = options[i].value;
        opt.textContent = options[i].label;
        if (options[i].value === type) opt.selected = true;
        select.appendChild(opt);
      }
      typeWrapper.appendChild(select);
      header.appendChild(typeWrapper);

      var removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-danger btn-sm btn-remove-trig';
      removeBtn.textContent = '✕';
      removeBtn.title = 'Remove trigger';
      removeBtn.onclick = function() { removeTriggerRule(this); };
      header.appendChild(removeBtn);
      row.appendChild(header);

      var fields = document.createElement('div');
      fields.className = 'trigger-fields';

      fields.innerHTML =
        '<div class="form-group field-branches" style="' + (type === 'git_push' ? 'margin-bottom: 8px;' : 'display: none; margin-bottom: 8px;') + '">' +
          '<label>Branch Patterns (Comma-separated globs, e.g. main, feature/*):</label>' +
          '<input class="form-control" type="text" name="trigger_branches" placeholder="e.g. main, feature/*, release/*">' +
        '</div>' +
        '<div class="form-group field-tags" style="' + (type === 'git_tag' ? 'margin-bottom: 8px;' : 'display: none; margin-bottom: 8px;') + '">' +
          '<label>Tag Patterns (Comma-separated globs, e.g. v*.*.*, release-*):</label>' +
          '<input class="form-control" type="text" name="trigger_tags" placeholder="e.g. v*.*.*, release-*">' +
        '</div>' +
        '<div class="form-group field-endpoint" style="' + (type === 'webhook' ? 'margin-bottom: 8px;' : 'display: none; margin-bottom: 8px;') + '">' +
          '<label>Webhook Endpoint Path:</label>' +
          '<input class="form-control" type="text" name="trigger_endpoint" placeholder="e.g. /api/v1/triggers/deploy">' +
        '</div>' +
        '<div class="form-group field-cron" style="' + (type === 'cron' ? 'margin-bottom: 8px;' : 'display: none; margin-bottom: 8px;') + '">' +
          '<label>Cron Schedule Expression:</label>' +
          '<input class="form-control" type="text" name="trigger_cron" placeholder="e.g. 0 0 * * 0">' +
        '</div>';

      row.appendChild(fields);
      container.appendChild(row);
    }

    document.addEventListener("DOMContentLoaded", function() {
      if (initialSteps && initialSteps.length > 0) {
        for (var i = 0; i < initialSteps.length; i++) {
          addBuildStep(initialSteps[i].type, initialSteps[i]);
        }
      } else if (initialScript && initialScript.length > 0) {
        addBuildStep('process', {
          name: 'Execute Script',
          type: 'process',
          script: initialScript,
          working_directory: initialTaskWorkDir
        });
      } else {
        addBuildStep('process', {
          name: 'Build Step',
          type: 'process',
          script: ''
        });
      }
    });
