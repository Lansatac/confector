extends layout

block maincontent
  div.repositories-container
    div.header-section
      div(style="margin-bottom: 8px; font-size: 0.9em;")
        a(href="/repositories/", style="color: var(--text-muted, #64748b); text-decoration: none;") Repositories
        span.text-muted(style="margin: 0 6px;") /
        span.text-muted Add Repository
      h1 Register Repository
      p Add a remote repository address to make it available for discrete task inputs and step runners.

    - if (errorMessage.length > 0)
      div.alert.alert-danger(style="max-width: 680px; margin-top: 15px; padding: 12px 16px; background-color: #fee2e2; color: #991b1b; border-radius: 6px; border: 1px solid #f87171;")
        strong Error: 
        span #{errorMessage}

    div.card(style="max-width: 680px; margin-top: 20px;")
      form(action="/repositories/add", method="POST")
        div.form-group
          label(for="name") Repository Identifier / Name:
          input.form-control#name(type="text", name="name", placeholder="e.g. confector-core", required)

        div.form-group
          label(for="address") Remote Address / URL:
          input.form-control#address(type="text", name="address", placeholder="e.g. https://github.com/org/repo.git", required)

        div.form-group
          label(for="refresh-policy") Change Detection Policy:
          select.form-control#refresh-policy(name="refresh-policy")
            option(value="webhook", selected) Webhook — React to push events from the VCS provider
            option(value="polling") Polling — Periodically check for new revisions
            option(value="both") Both — Use webhooks and polling together
          small.text-muted(style="display: block; margin-top: 4px;") Webhooks require the VCS provider to send events to this server. Polling works without external configuration.

        div(style="margin-top: 20px; display: flex; gap: 10px;")
          button.btn.btn-primary(type="submit") Register Repository
          a.btn.btn-outline(href="/repositories/") Cancel