{
	"authors": [
		"Jason Yegge"
	],
	"copyright": "Copyright © 2023, Jason Yegge",
	"description": "A build system.",
	"license": "The Unlicense",
	"name": "confector",
	"targetType": "none",

    "dependencies": {
      "confector:server": "*",
      "confector:runner": "*",
      "confector:plugins": "*"
    },
	"subPackages": [
		{
			"name": "config",
			"targetType": "library",
			"sourcePaths": ["source/confector/config"],
			"importPaths": ["source"],
			"targetPath": "out/lib",
			"dependencies": {
				"vibe-serialization": "~>1.2.0"
			}
		},
    {
      "name": "server",
      "targetType": "executable",
      "targetPath": "out/server",
      "workingDirectory": "out/server",
      "sourcePaths": ["source/confector/server"],
      "copyFiles": ["public"],
      "dependencies": {
        "diet-ng": "~>1.8",
        "vibe-d": "~>0.10.3",
        "confector:config": "*",
        "confector:core": "*",
        "confector:runner_core": "*"
      }
    },
		{
			"name": "plugin_api",
			"targetType": "library",
			"sourcePaths": ["source/confector/plugin_api"],
			"importPaths": ["source"],
			"targetPath": "out/lib",
			"dependencies": {
				"confector:config": "*",
				"vibe-serialization": "~>1.2.0"
			}
		},
		{
			"name": "core",
			"targetType": "library",
			"sourcePaths": ["source/confector/core", "source/confector/queue"],
			"importPaths": ["source"],
			"targetPath": "out/lib",
			"dependencies": {
				"confector:config": "*",
				"confector:plugin_api": "*",
				"vibe-d": "~>0.10.3"
			}
		},
		{
			"name": "runner_core",
			"targetType": "library",
			"sourcePaths": ["source/confector/runner_core"],
			"importPaths": ["source"],
			"targetPath": "out/lib",
			"dependencies": {
				"confector:core": "*"
			}
		},
		{
			"name": "runner",
			"targetType": "executable",
			"targetName": "confector-runner",
			"sourcePaths": ["source/confector/runner_app"],
			"importPaths": ["source"],
			"targetPath": "out/runner",
			"workingDirectory": "out",
			"dependencies": {
				"confector:runner_core": "*",
				"confector:core": "*"
			}
		},
    {
      "name": "plugins",
      "targetType": "none",
      "dependencies": {
        "confector:bash_def": "*",
        "confector:bash_runner": "*",
        "confector:git_def": "*",
        "confector:git_runner": "*",
        "confector:powershell_def": "*",
        "confector:powershell_runner": "*",
        "confector:local_process": "*",
        "confector:local_artifact": "*"
      }
    },
		"./plugins/definition/bash",
		"./plugins/definition/git",
		"./plugins/definition/powershell",
		"./plugins/step_executor/bash",
		"./plugins/step_executor/git",
		"./plugins/step_executor/powershell",
		"./plugins/worker/local_process",
		"./plugins/artifact/local"
	]
}
