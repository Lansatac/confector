extends layout

block maincontent
  div.pipelines-container
    div.header-section
      div(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 #{pipeline.id.length > 0 ? "Edit Pipeline DAG" : "Author New Pipeline DAG"}
          p Configure arbitrary task nodes, dependencies, file inputs, upstream artifact staging, and scripts.
        div
          - if (project.id.length > 0)
            a.btn.btn-outline(href="/projects/details?id=#{project.id}") Back
          - else
            a.btn.btn-outline(href="/pipelines/") Back

    div.section-title-bar(style="margin-top: 15px;")
      h2 Visual DAG Preview
    div#pipeline-canvas-container.dag-visualizer
      canvas#dag-editor-canvas(width="800", height="220")

    form#pipeline-form(action="/pipelines/save", method="POST", style="margin-top: 20px;")
      div.grid-2col
        div.card
          h3 Pipeline Information
          div.form-group
            label(for="id") Pipeline Identifier:
            input.form-control#id(type="text", name="id", value="#{pipeline.id}", placeholder="e.g. self-build-pipeline")

          div.form-group
            label(for="project_id") Associated Project:
            select.form-control#project_id(name="project_id")
              option(value="") -- Select Project (Optional) --
              - foreach(p; projects)
                - if (p.id == pipeline.projectId || p.id == project.id)
                  option(value="#{p.id}", selected) #{p.name} (#{p.id})
                - else
                  option(value="#{p.id}") #{p.name} (#{p.id})

          div.form-group
            label(for="name") Pipeline Name:
            input.form-control#name(type="text", name="name", value="#{pipeline.name}", placeholder="e.g. Full Release Self-Build", required)

          div.form-group
            label(for="description") Description:
            textarea.form-control#description(name="description", rows="2", placeholder="Description of what this pipeline builds or validates") #{pipeline.description}

        div.card
          h3 Pipeline Definition (JSON / Nodes)
          p Define the complete arbitrary DAG specification with generic task nodes:
          div.form-group
            label(for="definition_json") Pipeline Tasks JSON:
            textarea.form-control#definition_json(name="definition_json", rows="10", style="font-family: monospace; font-size: 13px;", required)

          div(style="display: flex; gap: 10px; margin-top: 10px;")
            button.btn.btn-outline#btn-refresh-preview(type="button") Refresh DAG Preview
            button.btn.btn-outline#btn-load-sample(type="button") Load Confector Self-Build Sample

      div(style="margin-top: 20px; display: flex; gap: 10px;")
        button.btn.btn-primary#btn-save-pipeline(type="submit") Save Pipeline
        - if (project.id.length > 0)
          a.btn.btn-outline(href="/projects/details?id=#{project.id}") Cancel
        - else
          a.btn.btn-outline(href="/pipelines/") Cancel

  script(src="/static/scripts/dag_visualizer.js")
  script.
    var currentPipelineTasks = !{tasksJson};

    function updatePreview() {
      var jsonText = document.getElementById("definition_json").value;
      try {
        var parsed = JSON.parse(jsonText);
        var tasks = Array.isArray(parsed) ? parsed : (parsed.tasks || []);
        if (window.renderPipelineDAG) {
          window.renderPipelineDAG("dag-editor-canvas", tasks);
        }
      } catch (e) {
        console.warn("Invalid JSON in editor preview:", e);
      }
    }

    document.addEventListener("DOMContentLoaded", function() {
      var defArea = document.getElementById("definition_json");
      if (currentPipelineTasks && currentPipelineTasks.length > 0) {
        defArea.value = JSON.stringify({ version: "1.0", tasks: currentPipelineTasks }, null, 2);
      } else {
        var defaultTasks = [
          {
            "id": "unit-tests",
            "name": "Unit Tests",
            "depends_on": [],
            "script": "dub test",
            "inputs": {
              "files": ["source/**/*.d", "dub.json"],
              "env": []
            }
          },
          {
            "id": "compile-release",
            "name": "Compile Binary",
            "depends_on": ["unit-tests"],
            "script": "dub build --build=release",
            "inputs": {
              "files": ["source/**/*.d", "views/**/*.dt", "public/**/*", "dub.json"]
            },
            "outputs": {
              "artifacts": [{ "path": "confector.exe", "type": "binary" }]
            }
          },
          {
            "id": "verify-artifact",
            "name": "Verify Artifact",
            "depends_on": ["compile-release"],
            "script": "confector.exe --version || echo Binary verified",
            "inputs": {
              "upstream_artifacts": [{ "task_id": "compile-release", "name": "confector.exe" }]
            }
          }
        ];
        defArea.value = JSON.stringify({ version: "1.0", tasks: defaultTasks }, null, 2);
      }

      updatePreview();

      document.getElementById("btn-refresh-preview").addEventListener("click", updatePreview);
      defArea.addEventListener("input", function() {
        try { updatePreview(); } catch (e) {}
      });

      document.getElementById("btn-load-sample").addEventListener("click", function() {
        var selfBuildSample = {
          "version": "1.0",
          "tasks": [
            {
              "id": "unit-tests",
              "name": "Unit Tests",
              "depends_on": [],
              "script": "dub test",
              "inputs": {
                "files": ["source/**/*.d", "dub.json"]
              }
            },
            {
              "id": "compile-release",
              "name": "Compile Binary",
              "depends_on": ["unit-tests"],
              "script": "dub build --build=release",
              "inputs": {
                "files": ["source/**/*.d", "views/**/*.dt", "public/**/*", "dub.json"]
              },
              "outputs": {
                "artifacts": [{ "path": "confector.exe", "type": "binary" }]
              }
            },
            {
              "id": "verify-artifact",
              "name": "Verify Artifact",
              "depends_on": ["compile-release"],
              "script": "confector.exe --version || echo Binary verified",
              "inputs": {
                "upstream_artifacts": [{ "task_id": "compile-release", "name": "confector.exe" }]
              }
            }
          ]
        };
        defArea.value = JSON.stringify(selfBuildSample, null, 2);
        updatePreview();
      });
    });
