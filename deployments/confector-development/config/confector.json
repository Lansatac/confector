{
  "server": {
    "logLevel": "info",
    "http": {
      "port": 8080,
      "bindAddress": "0.0.0.0"
    },
    "documentStore": {
      "connectionString": "mongodb://mongo:27017",
      "database": "confector"
    },
    "scheduler": {
      "callbackSecret": "dev-scheduler-secret"
    },
    "plugins": {
      "bundledPluginsDir": "./plugins"
    }
  },
  "plugins": {
    "mongo-queue": {
      "connectionString": "mongodb://mongo:27017",
      "dbName": "confector"
    },
    "local-scheduler": {
      "callbackSecret": "dev-scheduler-secret"
    },
    "local-process": {
      "runnerBinary": "/code/build/out/runner/confector-runner",
      "serverUrl": "http://development:8080",
      "workspaceDir": "/runner/workspace",
      "storageDir": "/runner/artifacts",
      "pluginsDir": "/code/out/runner/plugins",
      "maxConcurrency": 0,
      "supportedExecutorTypes": ["local", "local_process", ""]
    }
  }
}