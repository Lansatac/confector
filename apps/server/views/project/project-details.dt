extends layout

block maincontent
  div.projects-container
    div.header-section
      div(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 #{project.name}
          p #{project.description.length > 0 ? project.description : "No description provided."}
        div(style="display: flex; gap: 10px;")
          a.btn.btn-primary(href="/projects/tasks/edit?project_id=#{project.id}") + Add Task
          form(action="/projects/run", method="POST", style="display:inline;")
            input(type="hidden", name="id", value="#{project.id}")
            input(type="hidden", name="all", value="1")
            button.btn.btn-success(type="submit") Execute All Tasks
          a.btn.btn-secondary(href="/projects/edit?id=#{project.id}") Edit JSON Graph
          a.btn.btn-outline(href="/projects/") Back to Projects

    - if (buildForm.created.length > 0)
      div.alert.alert-success#build-created(style="margin-top: 20px;") Created build #{buildForm.created}.
    - if (buildForm.warning.length > 0)
      div.alert.alert-warning#build-warning(style="margin-top: 20px;") #{buildForm.warning}
    - if (buildForm.error.length > 0)
      div.alert.alert-danger#build-error(style="margin-top: 20px; white-space: pre-line;")
        strong The build was not started:
        div #{buildForm.error}

    - if (project.tasks.length > 0)
      div.card#build-form(style="margin-top: 20px;")
        h3 Build
        form(action="/projects/run", method="POST")
          input(type="hidden", name="id", value="#{project.id}")
          div.form-group
            label Tasks to build (with their upstream tasks):
            - import std.algorithm.searching : canFind;
            - foreach(t; project.tasks)
              div
                label
                  input(type="checkbox", name="target_task_id", value="#{t.id}", checked=buildForm.targets.canFind(t.id))
                  |  #{t.name.length > 0 ? t.name : t.id}
          - if (buildForm.refs.length > 0)
            div.form-group
              label Ref of each repository (empty: the build's ref, else the default shown):
              - foreach(row; buildForm.refs)
                div(style="display: flex; gap: 10px; align-items: center; margin-bottom: 6px;")
                  code(style="min-width: 140px;") #{row.repository}
                  input(type="hidden", name="ref_repository", value="#{row.repository}")
                  input.form-control(type="text", name="ref_name", value="#{row.ref_}", placeholder="#{row.hint}")
          div.form-group
            label(for="chain_number") Add to an existing build (number, empty starts a new build):
            input.form-control#chain_number(type="text", name="chain_number", value="#{buildForm.chainNumber}", placeholder="e.g. 12")
          button.btn.btn-success(type="submit") Build

    div.grid-2col(style="margin-top: 20px;")
      div.card
        h3 Project Configuration
        table.data-table
          tr
            th ID
            td
              code #{project.id}
          tr
            th Created At
            td #{project.createdAt}
          tr
            th Updated At
            td #{project.updatedAt}

      div.card
        h3 Quick Actions
        p Manage discrete DAG tasks and execute targeted workflow slices.
        div(style="display: flex; flex-direction: column; gap: 10px;")
          a.btn.btn-primary(href="/projects/tasks/edit?project_id=#{project.id}") Add New Discrete Task
          a.btn.btn-outline(href="/projects/edit?id=#{project.id}") Edit Project & Tasks JSON
          form(action="/projects/delete", method="POST")
            input(type="hidden", name="id", value="#{project.id}")
            button.btn.btn-danger(type="submit", onclick="return confirm('Delete this project and all its tasks?');") Delete Project

    - if (project.tasks.length > 0)
      div.section-title-bar(style="margin-top: 30px;")
        h2 Visual Task Graph Preview
        div.graph-legend
          span.legend-item
            span.dot.dot-primary
            span Task
          span.legend-item
            span.dot.dot-repo
            span Repository
      div#project-dag-container.dag-visualizer
        canvas#project-dag-canvas(width="800", height="220")

    div.section-title-bar(style="margin-top: 30px;")
      h2 Task Registry for #{project.name}

    - if (project.tasks.length == 0)
      div.empty-state
        p No tasks configured for this project yet.
        a.btn.btn-primary(href="/projects/tasks/edit?project_id=#{project.id}") Add Your First Task
    - else
      table.data-table
        thead
          tr
            th Task ID
            th Name
            th Depends On
            th Inputs / Artifacts
            th Steps / Execution
            th Actions
        tbody
          - foreach(t; project.tasks)
            tr
              td
                a(href="/tasks/details?project_id=#{project.id}&task_id=#{t.id}")
                  code #{t.id}
              td
                a(href="/tasks/details?project_id=#{project.id}&task_id=#{t.id}", style="font-weight: 600; text-decoration: none; color: inherit;") #{t.name.length > 0 ? t.name : t.id}
              td
                - import confector.api.model : upstreamTaskIds, repositoryIds, InputKind;
                - auto upstreamTasks = upstreamTaskIds(t);
                - if (upstreamTasks.length > 0)
                  div(style="display: flex; flex-wrap: wrap; gap: 4px;")
                    - foreach(dep; upstreamTasks)
                      span.badge.badge-secondary #{dep}
                - else
                  span(style="color: #6c757d; font-size: 0.85em;") Root node (None)
              td
                div(style="font-size: 0.85em;")
                  - size_t repoCount = repositoryIds(t).length;
                  - size_t upstreamArtifactCount = 0;
                  - foreach(decl; t.inputs.byValue) { if (decl.kind == InputKind.taskOutput && decl.spec.artifact.length > 0) upstreamArtifactCount++; }
                  - if (repoCount > 0)
                    div
                      strong Repos: 
                      span #{repoCount} repo(s)
                  - if (upstreamArtifactCount > 0)
                    div
                      strong Upstream: 
                      span #{upstreamArtifactCount} artifact(s)
                  - if (t.outputs.artifacts.length > 0)
                    div
                      strong Outputs: 
                      span #{t.outputs.artifacts.length} artifact(s)
              td
                - if (t.steps.length > 0)
                  div
                    span.badge.badge-primary #{t.steps.length} step(s)
                    - foreach(st; t.steps)
                      div(style="font-size: 0.8em; color: #555; margin-top: 2px;")
                        strong #{st.type}: 
                        span #{st.name.length > 0 ? st.name : st.type}
                - else
                  span(style="color: #6c757d; font-size: 0.85em;") No steps defined
              td
                div(style="display: flex; gap: 5px;")
                  form(action="/projects/run", method="POST", style="display:inline;")
                    input(type="hidden", name="id", value="#{project.id}")
                    input(type="hidden", name="target_task_id", value="#{t.id}")
                    button.btn.btn-sm.btn-primary(type="submit", title="Execute this task and upstream dependencies") Run
                  a.btn.btn-sm.btn-outline(href="/tasks/details?project_id=#{project.id}&task_id=#{t.id}") Details
                  a.btn.btn-sm.btn-outline(href="/projects/tasks/edit?project_id=#{project.id}&task_id=#{t.id}") Edit
                  form(action="/projects/tasks/delete", method="POST", style="display:inline;")
                    input(type="hidden", name="project_id", value="#{project.id}")
                    input(type="hidden", name="task_id", value="#{t.id}")
                    button.btn.btn-sm.btn-danger(type="submit", onclick="return confirm('Delete task #{t.id}?');") Delete

  script(src="/static/scripts/dag_visualizer.js")
  script.
    document.addEventListener("DOMContentLoaded", function() {
      var tasksData = !{tasksJson};
      if (tasksData && tasksData.length && window.renderTaskGraph) {
        window.renderTaskGraph("project-dag-canvas", tasksData);
      }
    });
