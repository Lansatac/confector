extends layout

block maincontent
  div.task-details-container
    div.header-section
      div(style="margin-bottom: 8px; font-size: 0.9em;")
        a(href="/projects/", style="color: var(--text-muted, #64748b); text-decoration: none;") Projects
        span.text-muted(style="margin: 0 6px;") /
        a(href="/projects/details?id=#{project.id}", style="color: var(--text-muted, #64748b); text-decoration: none;") #{project.name.length > 0 ? project.name : project.id}
        span.text-muted(style="margin: 0 6px;") /
        span.text-muted #{taskNode.name.length > 0 ? taskNode.name : taskNode.id}
      div.title-row
        div
          h1 Task: #{taskNode.name.length > 0 ? taskNode.name : taskNode.id}
          p.text-muted(style="margin: 4px 0 0 0;") Discrete DAG node definition in project #[a(href="/projects/details?id=#{project.id}") #{project.name.length > 0 ? project.name : project.id}] (#[code #{taskNode.id}])

    div.toolbar-actions(style="margin-bottom: 24px; display: flex; gap: 10px; flex-wrap: wrap; align-items: center;")
      form(action="/projects/run", method="POST", style="display:inline;")
        input(type="hidden", name="id", value="#{project.id}")
        input(type="hidden", name="target_task_id", value="#{taskNode.id}")
        button.btn.btn-primary(type="submit", title="Execute this task and upstream dependencies") ⚡ Run Task
      a.btn.btn-secondary(href="/projects/tasks/edit?project_id=#{project.id}&task_id=#{taskNode.id}") ⚙ Edit Task Settings
      a.btn.btn-outline(href="/projects/details?id=#{project.id}") &larr; Back to Project

    div.section-title-bar
      h2 Task Configuration
      div
        span.badge.badge-primary #{taskNode.steps.length} step(s)

    div.grid-2col(style="margin-bottom: 30px;")
      div.card
        h3 Dependencies & Inputs
        table.data-table
          tr
            th(style="width: 140px;") Upstream Tasks
            td
              - import confector.core.model : upstreamTaskIds, repositoryIds, InputKind;
              - auto upstreamTasks = upstreamTaskIds(taskNode);
              - if (upstreamTasks.length > 0)
                div(style="display: flex; flex-wrap: wrap; gap: 6px;")
                  - foreach(dep; upstreamTasks)
                    a.badge.badge-secondary(href="/tasks/details?project_id=#{project.id}&task_id=#{dep}", style="text-decoration: none;") #{dep}
              - else
                span.text-muted Root task (No dependencies)
          tr
            th Repositories
            td
              - if (repositoryIds(taskNode).length > 0)
                div(style="display: flex; flex-wrap: wrap; gap: 6px;")
                  - foreach(inputName, decl; taskNode.inputs)
                    - if (decl.kind == InputKind.repository)
                      span.badge.badge-info #{inputName}: #{decl.spec.repository} @ #{decl.spec.refSelector}
              - else
                span.text-muted None
          tr
            th Upstream Artifacts
            td
              - bool hasUpstreamArtifacts = false;
              - foreach(decl; taskNode.inputs.byValue) { if (decl.kind == InputKind.taskOutput && decl.spec.artifact.length > 0) hasUpstreamArtifacts = true; }
              - if (hasUpstreamArtifacts)
                div(style="display: flex; flex-direction: column; gap: 4px;")
                  - foreach(inputName, decl; taskNode.inputs)
                    - if (decl.kind == InputKind.taskOutput && decl.spec.artifact.length > 0)
                      div
                        code #{decl.spec.task}:#{decl.spec.artifact}
              - else
                span.text-muted None
          tr
            th Values
            td
              - bool hasValues = false;
              - foreach(decl; taskNode.inputs.byValue) { if (decl.kind == InputKind.value) hasValues = true; }
              - if (hasValues)
                div(style="display: flex; flex-direction: column; gap: 4px;")
                  - foreach(inputName, decl; taskNode.inputs)
                    - if (decl.kind == InputKind.value)
                      div
                        code #{inputName}=#{decl.spec.value}
              - else
                span.text-muted None

      div.card
        h3 Outputs & Triggers
        table.data-table
          tr
            th(style="width: 140px;") Declared Outputs
            td
              - if (taskNode.outputs.artifacts.length > 0)
                div(style="display: flex; flex-direction: column; gap: 4px;")
                  - foreach(art; taskNode.outputs.artifacts)
                    div
                      strong #{art.effectiveId}: 
                      code #{art.effectivePath}
              - else
                span.text-muted No output artifacts declared
          tr
            th Triggers
            td
              - if (taskNode.triggers.length > 0)
                div(style="display: flex; flex-wrap: wrap; gap: 6px;")
                  - foreach(trig; taskNode.triggers)
                    span.badge.badge-primary #{trig.type}
              - else
                span.text-muted Manual dispatch only

    div.section-title-bar(style="margin-top: 20px;")
      h2 Build Step Breakdown
      div
        span.badge.badge-primary #{taskNode.steps.length} configured steps

    - if (taskNode.steps.length == 0)
      div.empty-state(style="padding: 15px; margin-bottom: 30px;")
        p No discrete build steps configured.
    - else
      table.data-table(style="margin-bottom: 30px;")
        thead
          tr
            th #
            th Step Type
            th Step Name
            th Target Command / Script
            th Working Directory
        tbody
          - foreach(size_t idx, step; taskNode.steps)
            tr
              td #{idx + 1}
              td
                span.badge.badge-info #{step.type}
              td
                strong #{step.name.length > 0 ? step.name : step.type}
              td
                - string cmdSummary = step.script.length > 0 ? step.script : step.command;
                - if (cmdSummary.length == 0 && "script" in step.parameters) cmdSummary = step.parameters["script"];
                - if (cmdSummary.length == 0 && "command" in step.parameters) cmdSummary = step.parameters["command"];
                - if (cmdSummary.length > 60)
                  code #{cmdSummary[0 .. 60]}...
                - else if (cmdSummary.length > 0)
                  code #{cmdSummary}
                - else
                  span.text-muted -
              td #{step.workingDirectory.length > 0 ? step.workingDirectory : "."}
