{
  "server": {
    "logLevel": "info",
    "http": {
      "port": 8080,
      "bindAddress": "0.0.0.0"
    },
    "documentStore": {
      "connectionString": "mongodb://mongo:27017",
      "database": "confector"
    },
    "scheduler": {
      "callbackSecret": "dev-scheduler-secret"
    },
    "workerPool": {
      "credential": "dev-worker-pool-credential-0123456789"
    },
    "artifactStore": {
      "baseDirectory": "/artifacts"
    },
    "auth": {
      "trustedProxy": {
        "secret": "dev-proxy-secret-0123456789abcdef",
        "roles": {
          "admins": ["dev@confector.localhost"],
          "members": ["dev-members"],
          "viewers": ["dev-viewers"]
        }
      }
    }
  }
}