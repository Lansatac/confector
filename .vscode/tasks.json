{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "reggae: build server",
      "type": "shell",
      "command": "ninja server",
      "options": { "cwd": "${workspaceFolder}/build" },
      "problemMatcher": ["$dmd"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "reggae: build all",
      "type": "shell",
      "command": "ninja",
      "options": { "cwd": "${workspaceFolder}/build" },
      "problemMatcher": ["$dmd"],
      "group": "build"
    },
    {
      "label": "dub: test package",
      "type": "shell",
      "command": "dub test :${input:package}",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$dmd"],
      "group": "test"
    }
  ],
  "inputs": [
    {
      "id": "package",
      "type": "pickString",
      "description": "Sub-package to test",
      "options": [
        "core", "plugin-api", "config", "mongo-helpers", "runner-core", "testing", "server", "runner",
        "document-store-mongo", "queue-mongo"
      ],
      "default": "core"
    }
  ]
}
