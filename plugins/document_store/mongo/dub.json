	"targetType": "library",
	"targetName": "confector_mongo_document_store",
	"targetPath": "../../../out/lib",
	"dependencies": {
		"confector:plugin-api": {
			"path": "../../.."
		},
		"mongo-standalone": "~>0.0.15"
