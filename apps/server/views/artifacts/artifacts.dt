extends layout

block maincontent
  div.admin-container
    div.header-section
      h1 Artifact Storage
      p The artifact storage backends registered with the server. The default backend is chosen when the server starts.

    div.stats-grid(style="margin-top: 20px;")
      div.stat-card
        div.stat-value #{storages.length}
        div.stat-label Available Backends
      div.stat-card
        div.stat-value #{defaultType.length > 0 ? defaultType : "none"}
        div.stat-label Default Backend

    - if (storages.length == 0)
      div.empty-state
        p No artifact storage backends are registered. Load an artifact plugin to enable artifact storage.
    - else
      table.data-table(style="margin-top: 25px;")
        thead
          tr
            th Backend
            th Type
            th Description
            th Default
        tbody
          - foreach(s; storages)
            tr
              td #{s.displayName}
              td
                code #{s.backendType}
              td #{s.description}
              td
                - if (defaultType == s.backendType)
                  span.badge.badge-primary Default
