extends layout

block maincontent
  div.projects-container
    div.header-section
      div.d-flex.justify-content-between.align-items-center(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 Projects
          p Manage project workspaces, repositories, and custom execution pipelines.
        div
          a.btn.btn-primary(href="/projects/add") + New Project

    div.section-title-bar(style="margin-top: 20px;")
      h2 Registered Projects

    - if (projects.length == 0)
      div.empty-state
        p No projects defined yet.
        a.btn.btn-primary(href="/projects/add") Create Your First Project
    - else
      table.data-table
        thead
          tr
            th ID
            th Project Name
            th Workspace Directory
            th Repository URL
            th Created At
            th Actions
        tbody
          - foreach(p; projects)
            tr
              td
                code #{p.id}
              td
                a(href="/projects/details?id=#{p.id}", style="font-weight: bold; text-decoration: none;") #{p.name}
              td
                code #{p.workspaceDir}
              td #{p.repositoryUrl.length > 0 ? p.repositoryUrl : "—"}
              td #{p.createdAt}
              td
                a.btn.btn-sm.btn-outline(href="/projects/details?id=#{p.id}", style="margin-right: 5px;") View
                a.btn.btn-sm.btn-primary(href="/pipelines/edit?project_id=#{p.id}", style="margin-right: 5px;") + Pipeline
                form(action="/projects/delete", method="POST", style="display:inline;")
                  input(type="hidden", name="id", value="#{p.id}")
                  button.btn.btn-sm.btn-danger(type="submit", onclick="return confirm('Delete project?');") Delete
