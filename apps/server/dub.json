{
	"name": "server",
	"targetType": "executable",
	"targetName": "confector_server",
	"targetPath": "../../out/server",
	"workingDirectory": "../../out/server",
	"copyFiles": [
		"public"
	],
	"dependencies": {
		"confector:config": {
			"path": "../.."
		},
		"confector:core": {
			"path": "../.."
		},
		"mongo-standalone": "~>0.0.15",
		"confector:document-store-mongo": {
			"path": "../.."
		},
		"confector:scheduler-local": {
			"path": "../.."
		},
		"confector:artifact-local": {
			"path": "../.."
		},
		"diet-ng": "~>1.8",
		"vibe-d": "~>0.10.3"
	},
	"configurations": [
		{
			"name": "application",
			"mainSourceFile": "source/confector/server/app.d"
		},
		{
			"name": "library",
			"targetType": "library",
			"targetName": "confector_server",
			"targetPath": "../../out/lib",
			"excludedSourceFiles": [
				"source/confector/server/app.d"
			]
		},
		{
			"name": "unittest",
			"mainSourceFile": "source/confector/server/app.d",
			"dependencies": {
				"confector:testing": {
					"path": "../.."
				}
			}
		}
	]
}
