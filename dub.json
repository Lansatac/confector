{
	"authors": [
		"Jason Yegge"
	],
	"copyright": "Copyright © 2023, Jason Yegge",
	"dependencies": {
		"diet-ng": "~>1.8",
		"vibe-d": "~>0.10.3",
		"confector:core": "*"
	},
	"description": "A build system.",
	"license": "The Unlicense",
	"name": "confector",
	"targetPath": "bin",
  "workingDirectory": "bin",
  "copyFiles": ["public"],
	"subPackages": [
		{
			"name": "plugin_api",
			"targetType": "library",
			"sourcePaths": ["source/confector/plugin_api"],
			"importPaths": ["source"],
	    "targetPath": "lib",
			"dependencies": {
				"vibe-serialization": "~>1.2.0"
			}
		},
		{
			"name": "core",
			"targetType": "library",
			"sourcePaths": ["source/confector/core"],
			"importPaths": ["source"],
	    "targetPath": "lib",
			"dependencies": {
				"confector:plugin_api": "*",
				"vibe-d": "~>0.10.3"
			}
		},
		"./plugins/bash",
		"./plugins/git",
		"./plugins/local_executor",
		"./plugins/powershell",
    {
      "name": "plugins",
      "targetType": "none",
      "dependencies": {
        "confector:bash": "*",
        "confector:git": "*",
        "confector:local_executor": "*",
        "confector:powershell": "*"
      }
    }
	]
}
