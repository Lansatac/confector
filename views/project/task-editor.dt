extends layout

block maincontent
  - import vibe.data.json : serializeToJson;
  - struct TaskOpt { string id; string name; }
  - TaskOpt[] availableTasksList;
  - foreach(t; project.tasks) { if (t.id != task.id) availableTasksList ~= TaskOpt(t.id, t.name); }
  - string availableTasksJson = serializeToJson(availableTasksList).toString();

  div.projects-container
    div.header-section
      div(style="display: flex; justify-content: space-between; align-items: center;")
        div
          h1 #{task.id.length > 0 ? "Edit Task: " ~ task.id : "Add New Task"}
          p Configure discrete DAG node inputs, dependencies, scripts, and output declarations for project #{project.name}.
        div
          a.btn.btn-outline(href="/projects/details?id=#{project.id}") Back to Project

    form(action="/projects/tasks/save", method="POST", style="margin-top: 20px;")
      input(type="hidden", name="project_id", value="#{project.id}")

      div.tabs-nav
        button.tab-btn.active(type="button", onclick="switchTab('general', this)") General
        button.tab-btn(type="button", onclick="switchTab('inputs', this)") Inputs
        button.tab-btn(type="button", onclick="switchTab('steps', this)") Steps
        button.tab-btn(type="button", onclick="switchTab('outputs', this)") Outputs

      div.card
        div#tab-general.tab-pane.active
          h3 General Settings
          div.form-group
            label(for="task_id") Task Identifier (ID):
            input.form-control#task_id(type="text", name="task_id", value="#{task.id}", placeholder="e.g. build-release, test-unit, deploy-stage", required)

          div.form-group
            label(for="name") Display Name:
            input.form-control#name(type="text", name="name", value="#{task.name}", placeholder="e.g. Build Release Binary")

        div#tab-inputs.tab-pane
          h3 Inputs & Upstream Dependencies
          div.form-group
            label Task Dependencies (Other tasks in this project):
            div#dependencies-container.dependency-list
              - foreach(dep; task.dependsOn)
                div.dependency-row(style="display: flex; gap: 8px; margin-bottom: 8px; align-items: center;")
                  select.form-control(name="depends_on", style="flex: 1;")
                    option(value="", disabled) -- Select a task --
                    - bool foundDep = false;
                    - foreach(t; project.tasks)
                      - if (t.id != task.id)
                        - if (t.id == dep)
                          - foundDep = true;
                          option(value="#{t.id}", selected) #{t.id}#{t.name.length > 0 ? " (" ~ t.name ~ ")" : ""}
                        - else
                          option(value="#{t.id}") #{t.id}#{t.name.length > 0 ? " (" ~ t.name ~ ")" : ""}
                    - if (!foundDep && dep.length > 0)
                      option(value="#{dep}", selected) #{dep}
                  button.btn.btn-danger.btn-sm.btn-remove-dep(type="button", onclick="removeDependency(this)", title="Remove dependency") ✕
            div(style="margin-top: 6px;")
              button.btn.btn-outline.btn-sm#add-dep-btn(type="button", onclick="addDependency()") + Add Dependency

          div.form-group
            label(for="input_files") Repositories & Input File Globs (Comma or newline separated):
            - string filesVal = "";
            - foreach(i, f; task.inputs.files) { if (i > 0) filesVal ~= "\n"; filesVal ~= f; }
            textarea.form-control#input_files(name="input_files", rows="3", placeholder="source/**/*.d\ndub.json\nviews/**/*.dt", style="font-family: monospace;") #{filesVal}

          div.form-group
            label(for="input_env") Environment Variables to Hash (Comma-separated keys):
            - string envVal = "";
            - foreach(i, e; task.inputs.env) { if (i > 0) envVal ~= ", "; envVal ~= e; }
            input.form-control#input_env(type="text", name="input_env", value="#{envVal}", placeholder="e.g. CHEATS, BUILD_TYPE, DUB_ARGS")

          div.form-group
            label(for="upstream_artifacts") Required Upstream Artifacts (Format: taskId:artifactPath per line):
            - string upVal = "";
            - foreach(i, up; task.inputs.upstreamArtifacts) { if (i > 0) upVal ~= "\n"; upVal ~= up.taskId ~ ":" ~ up.name; }
            textarea.form-control#upstream_artifacts(name="upstream_artifacts", rows="3", placeholder="build-release:confector.exe\ncompile:build/game.zip", style="font-family: monospace;") #{upVal}

        div#tab-steps.tab-pane
          h3 Execution Steps
          div.form-group
            label(for="script") Execution Script / Command:
            textarea.form-control#script(name="script", rows="6", placeholder="e.g. dub build --build=release", style="font-family: monospace;") #{task.script}

          div.form-group
            label(for="working_directory") Working Directory Override (Optional):
            input.form-control#working_directory(type="text", name="working_directory", value="#{task.workingDirectory}", placeholder="Leave blank to use project workspace")

        div#tab-outputs.tab-pane
          h3 Output Artifacts
          div.form-group
            label(for="output_artifacts") Produced Output Artifacts (Format: filePath:type or filePath per line):
            - string outVal = "";
            - foreach(i, outArt; task.outputs.artifacts) { if (i > 0) outVal ~= "\n"; outVal ~= outArt.path ~ (outArt.type.length > 0 ? ":" ~ outArt.type : ""); }
            textarea.form-control#output_artifacts(name="output_artifacts", rows="4", placeholder="bin/confector.exe:binary\nbuild/output.tar.gz:archive", style="font-family: monospace;") #{outVal}

        div(style="margin-top: 25px; padding-top: 15px; border-top: 1px solid #eee; display: flex; gap: 10px;")
          button.btn.btn-primary(type="submit") Save Task
          a.btn.btn-outline(href="/projects/details?id=#{project.id}") Cancel

  script.
    var availableTasks = !{availableTasksJson};

    function removeDependency(btn) {
      var row = btn.closest('.dependency-row');
      if (row) {
        row.remove();
      }
    }

    function addDependency(selectedId) {
      var container = document.getElementById('dependencies-container');
      if (!container) return;

      var row = document.createElement('div');
      row.className = 'dependency-row';
      row.style.cssText = 'display: flex; gap: 8px; margin-bottom: 8px; align-items: center;';

      var select = document.createElement('select');
      select.name = 'depends_on';
      select.className = 'form-control';
      select.style.flex = '1';

      var defaultOpt = document.createElement('option');
      defaultOpt.value = '';
      defaultOpt.disabled = true;
      if (!selectedId) defaultOpt.selected = true;
      defaultOpt.textContent = '-- Select a task --';
      select.appendChild(defaultOpt);

      var tasks = availableTasks || [];
      if (tasks.length === 0) {
        var noneOpt = document.createElement('option');
        noneOpt.value = '';
        noneOpt.disabled = true;
        noneOpt.textContent = 'No other tasks in this project';
        select.appendChild(noneOpt);
      } else {
        for (var i = 0; i < tasks.length; i++) {
          var opt = document.createElement('option');
          opt.value = tasks[i].id;
          opt.textContent = tasks[i].id + (tasks[i].name && tasks[i].name.length > 0 && tasks[i].name !== tasks[i].id ? ' (' + tasks[i].name + ')' : '');
          if (selectedId && tasks[i].id === selectedId) {
            opt.selected = true;
          }
          select.appendChild(opt);
        }
      }

      var removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'btn btn-danger btn-sm btn-remove-dep';
      removeBtn.textContent = '✕';
      removeBtn.title = 'Remove dependency';
      removeBtn.onclick = function() { removeDependency(this); };

      row.appendChild(select);
      row.appendChild(removeBtn);
      container.appendChild(row);
    }

    function switchTab(tabName, btn) {
      var panes = document.querySelectorAll('.tab-pane');
      for (var i = 0; i < panes.length; i++) {
        panes[i].classList.remove('active');
      }
      var buttons = document.querySelectorAll('.tab-btn');
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.remove('active');
      }
      var target = document.getElementById('tab-' + tabName);
      if (target) {
        target.classList.add('active');
      }
      if (btn) {
        btn.classList.add('active');
      }
    }
